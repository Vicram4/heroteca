---
import '../styles/global.css';
import { SITE, AVISOS } from '../config/site';
import { universosActivos, estiloUniverso, type Universo } from '../lib/datos';
import Marca from '../components/Marca.astro';
import BotonTema from '../components/BotonTema.astro';
import Buscador from '../components/Buscador.astro';
import ArchivoRojo from '../components/ArchivoRojo.astro';
import { guiasDe } from '../config/guias';
import { idiomaDe, textos, LOCALE } from '../i18n';
import { rutaEn, rutaEs, rutaEnIdioma } from '../i18n/rutas';
// Tipografías principales: se precargan para que el texto no cambie de tamaño al llegar la fuente
import barlow400 from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import barlow600 from '@fontsource/barlow/files/barlow-latin-600-normal.woff2?url';
import condensada700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import condensada800 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
const fuentes = [barlow400, barlow600, condensada700, condensada800];

interface Props {
  titulo?: string;
  descripcion?: string;
  universo?: Universo;
  /** Imagen para compartir en redes (ruta ya optimizada o dirección completa) */
  imagen?: string;
  /** Tipo de página para Open Graph */
  tipoOg?: 'website' | 'video.movie' | 'video.tv_show';
  /** Datos estructurados (schema.org) para buscadores */
  datos?: Record<string, unknown>;
  /** Pide a los buscadores que no la indexen (página de error) */
  noIndexar?: boolean;
  /** Migas de pan (sin la página actual al final no hace falta: se añade sola) para los buscadores */
  migas?: { nombre: string; url: string }[];
}
const idioma = idiomaDe(Astro.url);
const tx = textos(Astro.url);
const {
  titulo,
  descripcion = tx.descripcion,
  universo,
  imagen = '/og-heroteca.jpg',
  tipoOg = 'website',
  datos,
  noIndexar = false,
  migas,
} = Astro.props;
// Migas de pan como datos estructurados (Google las muestra en los resultados)
const urlsMigas = await Promise.all((migas ?? []).map((m) => rutaEnIdioma(m.url, idioma)));
const datosMigas = migas?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: migas.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nombre, item: new URL(urlsMigas[i], SITE.url).href })),
    }
  : undefined;
// Fecha de la última actualización: la de la compilación
const actualizado = new Date().toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
const tituloPagina = titulo ? `${titulo} · ${SITE.nombre}` : `${SITE.nombre} · ${tx.lema}`;
const universos = await universosActivos();
const canonica = new URL(Astro.url.pathname, Astro.site);
// La misma página en los dos idiomas (direcciones completas: no las toca la reescritura de enlaces)
const rutaEspanol = idioma === 'en' ? await rutaEs(Astro.url.pathname) : Astro.url.pathname;
const rutaIngles = idioma === 'en' ? Astro.url.pathname : await rutaEn(Astro.url.pathname);
const alternativas = { es: new URL(rutaEspanol, SITE.url).href, en: new URL(rutaIngles, SITE.url).href };
// Mientras la versión inglesa no esté publicada, sus páginas no se indexan
const ocultar = noIndexar || (idioma === 'en' && !SITE.inglesPublicado);
const otroIdioma = idioma === 'en' ? alternativas.es : alternativas.en;
const verBotonIdioma = SITE.inglesPublicado || idioma === 'en';
---

<!doctype html>
<html lang={LOCALE[idioma]} data-universo={universo?.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fuentes.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    {/* Los carteles vienen del servidor de imágenes de TMDB: conectar con él cuanto antes */}
    <link rel="preconnect" href="https://image.tmdb.org" />
    <link rel="dns-prefetch" href="https://image.tmdb.org" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    {ocultar ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonica} />}
    {
      SITE.inglesPublicado && !noIndexar && (
        <>
          <link rel="alternate" hreflang="es" href={alternativas.es} />
          <link rel="alternate" hreflang="en" href={alternativas.en} />
          <link rel="alternate" hreflang="x-default" href={alternativas.es} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    {SITE.googleVerificacion && <meta name="google-site-verification" content={SITE.googleVerificacion} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content={tipoOg} />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content={LOCALE[idioma].replace('-', '_')} />
    {imagen && <meta property="og:image" content={new URL(imagen, Astro.site)} />}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
    {datos && <script type="application/ld+json" set:html={JSON.stringify(datos)} />}
    {datosMigas && <script type="application/ld+json" set:html={JSON.stringify(datosMigas)} />}
    <meta name="theme-color" content="#1a1d24" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f4f7" media="(prefers-color-scheme: light)" />
    <!-- Aplica el tema guardado antes de pintar, para que no parpadee -->
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t === 'claro' || t === 'oscuro') document.documentElement.dataset.tema = t;
      } catch {}
    </script>
  </head>
  <body style={estiloUniverso(universo)}>
    <a class="saltar" href="#contenido">{tx.general.saltar}</a>
    <header class="cabecera">
      <div class="contenedor fila">
        <Marca />
        <nav class="universos" aria-label={tx.general.universos}>
          {
            universos.map((u) => (
              <a href={`/${u.id}/`} aria-current={universo?.id === u.id ? 'true' : undefined} style={estiloUniverso(u)}>
                {u.data.nombre}
              </a>
            ))
          }
        </nav>
        <div class="acciones">
          <Buscador />
          {
            verBotonIdioma && (
              // Interruptor ES | EN: el idioma actual va resaltado y el otro es el enlace
              <div class="idiomas" role="group" aria-label={tx.general.idioma}>
                {(['es', 'en'] as const).map((i) =>
                  i === idioma ? (
                    <span class="activo" aria-current="true" title={tx.general.idiomaActual}>
                      {i.toUpperCase()}
                      <span class="solo-lectores"> ({tx.general.idiomaActual})</span>
                    </span>
                  ) : (
                    <a href={otroIdioma} hreflang={i} lang={i} title={tx.general.cambiarIdiomaAria}>
                      {i.toUpperCase()}
                      <span class="solo-lectores"> ({tx.general.cambiarIdioma})</span>
                    </a>
                  ),
                )}
              </div>
            )
          }
          <BotonTema />
        </div>
      </div>
      <slot name="subnav" />
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p class="pie-marca"><strong>{SITE.nombre}</strong> · {tx.lema}</p>
        <div class="pie-columnas">
          <nav aria-labelledby="pie-explorar">
            <h2 id="pie-explorar">{tx.pie.explorar}</h2>
            <ul>
              {universos.map((u) => <li><a href={`/${u.id}/`}>{u.data.nombre}</a></li>)}
              <li><a href="/proximamente/">{tx.proximos.pie}</a></li>
              <li><a href="/recomendaciones/">{tx.recomendar.pie}</a></li>
              <li><a href="/mi-progreso/">{tx.progreso.pie}</a></li>
              {universos.filter((u) => guiasDe(u.id).length).map((u) => <li><a href={`/${u.id}/guias/`}>{tx.pie.guiasDe(u.data.nombre)}</a></li>)}
            </ul>
          </nav>
          <nav aria-labelledby="pie-proyecto">
            <h2 id="pie-proyecto">{tx.pie.proyecto}</h2>
            <ul>
              <li><a href="/acerca/">{tx.pie.acerca}</a></li>
              <li><a href="/privacidad/">{tx.pie.privacidad}</a></li>
              <li><a href={`${SITE.repositorio}/issues`} rel="noopener">{tx.pie.error}</a></li>
              <li><a href={SITE.repositorio} rel="noopener">{tx.pie.codigo}</a></li>
            </ul>
          </nav>
          <section aria-labelledby="pie-datos">
            <h2 id="pie-datos">{tx.pie.datos}</h2>
            <ul class="fuentes">
              <li>
                <a href="https://www.themoviedb.org/" rel="noopener" class="logo-tmdb" aria-label="The Movie Database (TMDB)">
                  <img src="/tmdb.svg" alt="TMDB" width="110" height="14" loading="lazy" />
                </a>
                <span>{tx.pie.datosTmdb}</span>
              </li>
              <li>
                <a href={idioma === 'en' ? 'https://www.justwatch.com/us' : 'https://www.justwatch.com/es'} rel="noopener" class="justwatch">JustWatch</a>
                <span>{tx.pie.datosJustwatch}</span>
              </li>
            </ul>
          </section>
        </div>
        <div class="pie-legal">
          <p>{tx.pie.fans}</p>
          <p lang="en">{AVISOS.tmdb}</p>
          <p>{tx.pie.actualizado(actualizado)}</p>
        </div>
      </div>
    </footer>
    <ArchivoRojo />
    {
      SITE.cloudflareAnalytics && (
        // Estadísticas sin cookies; solo se cargan desde la dirección pública (no en pruebas locales)
        <script
          is:inline
          define:vars={{ host: new URL(SITE.url).hostname, token: SITE.cloudflareAnalytics }}
        >
          if (location.hostname === host) {
            const s = document.createElement('script');
            s.type = 'module';
            s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
            s.dataset.cfBeacon = JSON.stringify({ token });
            document.body.append(s);
          }
        </script>
      )
    }
    <script>
      // «Mi progreso»: marcas de visto, botones y contadores (src/lib/vistos.ts)
      import { iniciarVistos } from '../lib/vistos';
      iniciarVistos();

      // Spoilers en línea (||texto|| en las fichas): se revelan con clic, Intro o espacio
      document.querySelectorAll<HTMLElement>('.spoiler-linea').forEach((s) => {
        const alternar = () => s.setAttribute('aria-pressed', String(s.getAttribute('aria-pressed') !== 'true'));
        s.addEventListener('click', alternar);
        s.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            alternar();
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--fondo) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--borde);
  }
  .fila {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 28px);
    min-height: 72px;
  }
  .universos {
    display: flex;
    gap: 4px;
  }
  .universos a {
    font: 700 1.15rem var(--f-titulo);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--radio-s);
    color: var(--txt-2);
  }
  .universos a:hover {
    color: var(--txt);
  }
  .universos a[aria-current] {
    color: var(--txt);
    box-shadow: inset 0 -3px 0 var(--acento);
  }
  .acciones {
    margin-left: auto;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .idiomas {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: var(--sup);
  }
  .idiomas > * {
    min-width: 36px;
    padding: 6px 9px;
    border-radius: 999px;
    font: 700 0.85rem/1 var(--f-titulo);
    letter-spacing: 0.05em;
    text-align: center;
    text-decoration: none;
  }
  .idiomas .activo {
    background: var(--txt);
    color: var(--fondo);
  }
  .idiomas a {
    color: var(--txt-2);
  }
  .idiomas a:hover {
    color: var(--txt);
    background: var(--sup-2);
  }
  .pie {
    margin-top: 64px;
    border-top: 1px solid var(--borde);
    background: var(--fondo-2);
    color: var(--txt-2);
    font-size: 0.88rem;
    padding: 28px 0 34px;
  }
  .pie p {
    max-width: 75ch;
  }
  .pie-marca {
    color: var(--txt);
    font-size: 1rem;
  }
  .pie-columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 22px 40px;
    margin: 18px 0 26px;
  }
  .pie-columnas h2 {
    margin: 0 0 10px;
    font: 700 0.8rem var(--f-titulo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--txt-2);
  }
  .pie-columnas ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .pie-columnas a {
    color: var(--txt);
    text-decoration: none;
  }
  .pie-columnas a:hover {
    text-decoration: underline;
  }
  .fuentes li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .logo-tmdb img {
    height: 14px;
    width: auto;
    display: block;
    margin: 3px 0;
  }
  .justwatch {
    font-weight: 700;
  }
  .pie-legal {
    border-top: 1px solid var(--borde);
    padding-top: 16px;
    font-size: 0.82rem;
  }
  .pie-legal p {
    margin: 0 0 6px;
  }
  @media (max-width: 560px) {
    .universos a {
      font-size: 1rem;
      padding: 6px;
    }
  }
  /* Móviles estrechos: cabecera más compacta para que quepa todo en una fila */
  @media (max-width: 430px) {
    .fila {
      gap: 8px;
    }
    .acciones {
      gap: 5px;
    }
    .universos a {
      padding: 4px;
    }
    .idiomas > * {
      min-width: 28px;
      padding: 6px 5px;
    }
    .acciones :global(.pastilla) {
      padding: 8px 10px;
    }
  }
  /* Móviles muy estrechos (360 px): un poco más compacta todavía */
  @media (max-width: 380px) {
    .fila {
      gap: 6px;
    }
    .acciones {
      gap: 4px;
    }
    .fila :global(.marca .nombre) {
      font-size: 1.55rem;
    }
    .universos {
      gap: 0;
    }
    .universos a {
      font-size: 0.92rem;
    }
    .acciones :global(.pastilla) {
      padding: 7px 8px;
    }
    .idiomas > * {
      min-width: 26px;
      padding: 6px 4px;
    }
  }
</style>
