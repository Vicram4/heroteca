---
/**
 * Dos tipos de página bajo /<universo>/<clave>/:
 *  - una sección (UMC, Pre-UMC…): su estantería completa con filtros;
 *  - una ficha de título.
 */
import Base from '../../layouts/Base.astro';
import SubNav from '../../components/SubNav.astro';
import Estanteria from '../../components/Estanteria.astro';
import Ficha from '../../components/Ficha.astro';
import { getImage } from 'astro:assets';
import { SITE } from '../../config/site';
import { imagenTmdb } from '../../lib/tmdb';
import {
  universosActivos,
  titulosDe,
  huecosDeSeccion,
  huecosPorCarpetas,
  sagasDe,
  visionadosDe,
  urlCarpeta,
  type Titulo,
  type Universo,
  type Seccion,
  type Hueco,
  type Saga,
  type CabeceraCarpeta,
} from '../../lib/datos';

type Props =
  | { tipo: 'seccion'; universo: Universo; seccion: Seccion; huecos: Hueco[]; cabeceras: CabeceraCarpeta[]; sagas: Saga[] }
  | { tipo: 'ficha'; universo: Universo; t: Titulo; sagas: Saga[]; anterior?: Titulo; siguiente?: Titulo; temporadas: Titulo[] };

export async function getStaticPaths() {
  const rutas: { params: { universo: string; clave: string }; props: Props }[] = [];
  for (const universo of await universosActivos()) {
    const titulos = await titulosDe(universo.id);
    const sagas = await sagasDe(universo.id);
    const visionados = (await visionadosDe(universo.id)).map((v) => ({ carpeta: v.data.carpeta, url: urlCarpeta(universo.id, v.data.carpeta) }));
    for (const seccion of universo.data.secciones) {
      const deSeccion = titulos.filter((t) => t.d.seccion === seccion.id);
      const { huecos, cabeceras } =
        seccion.orden === 'carpetas'
          ? huecosPorCarpetas(deSeccion, seccion, visionados)
          : { huecos: huecosDeSeccion(deSeccion, seccion), cabeceras: [] };
      rutas.push({ params: { universo: universo.id, clave: seccion.id }, props: { tipo: 'seccion' as const, universo, seccion, huecos, cabeceras, sagas } });

      // Orden de la estantería (sin repetir temporadas troceadas) para «anterior / siguiente»
      const orden: Titulo[] = [];
      for (const h of huecos) if (!orden.includes(h.titulo)) orden.push(h.titulo);
      orden.forEach((t, i) => {
        const temporadas = t.d.serie
          ? titulos.filter((o) => o.d.serie === t.d.serie).sort((a, b) => (a.d.temporada ?? 0) - (b.d.temporada ?? 0))
          : [];
        rutas.push({
          params: { universo: universo.id, clave: t.id },
          props: { tipo: 'ficha' as const, universo, t, sagas, anterior: orden[i - 1], siguiente: orden[i + 1], temporadas },
        });
      });
    }
  }
  return rutas;
}

const p = Astro.props as Props;

/** Recorta un texto a ~155 caracteres sin partir palabras (para la descripción de buscadores). */
const resumen = (texto: string, max = 155) => {
  const t = texto.replace(/\s+/g, ' ').trim();
  return t.length <= max ? t : `${t.slice(0, max).replace(/\s+\S*$/, '')}…`;
};

// Ficha: descripción, imagen para compartir y datos estructurados (schema.org) para buscadores
let descripcionFicha: string | undefined;
let imagenSocial: string | undefined;
let datosFicha: Record<string, unknown> | undefined;
if (p.tipo === 'ficha') {
  const { t, universo } = p;
  const d = t.d;
  const nombre = d.temporada ? `${d.titulo} (temporada ${d.temporada})` : d.titulo;
  const base = `${t.subtitulo} de ${universo.data.nombre}, ${d.anioFin ? `${d.anio}–${d.anioFin}` : d.anio}.`;
  descripcionFicha = resumen(t.m.argumento ? `${nombre}: ${t.m.argumento}` : `${nombre}. ${base}`);
  imagenSocial = t.portada
    ? (await getImage({ src: t.portada, width: 600, format: 'jpg' })).src
    : t.m.posterTmdb
      ? imagenTmdb(t.m.posterTmdb, 'w500')
      : undefined;
  const url = new URL(t.url, SITE.url).href;
  const persona = (n: string) => ({ '@type': 'Person', name: n });
  const comun = {
    url,
    inLanguage: 'es',
    ...(imagenSocial && { image: new URL(imagenSocial, SITE.url).href }),
    ...(t.m.argumento && { description: resumen(t.m.argumento, 500) }),
    ...(t.m.generos.length && { genre: t.m.generos }),
    ...(t.m.reparto.length && { actor: t.m.reparto.slice(0, 10).map((r) => persona(r.actor)) }),
  };
  const fecha = t.m.fecha ? t.m.fecha.toISOString().slice(0, 10) : String(d.anio);
  datosFicha =
    d.tipo === 'serie' && d.temporada
      ? {
          '@context': 'https://schema.org',
          '@type': 'TVSeason',
          name: nombre,
          seasonNumber: d.temporada,
          startDate: fecha,
          partOfSeries: { '@type': 'TVSeries', name: d.titulo, ...(d.tituloOriginal && { alternateName: d.tituloOriginal }) },
          ...(t.m.capitulos.length && { numberOfEpisodes: t.m.capitulos.length }),
          ...comun,
        }
      : {
          '@context': 'https://schema.org',
          '@type': d.tipo === 'serie' ? 'TVSeries' : 'Movie',
          name: d.titulo,
          ...(d.tituloOriginal && { alternateName: d.tituloOriginal }),
          [d.tipo === 'serie' ? 'startDate' : 'datePublished']: fecha,
          ...(t.m.direccion.length && { director: t.m.direccion.map(persona) }),
          ...(t.m.duracion && d.tipo !== 'serie' && { duration: `PT${t.m.duracion}M` }),
          ...comun,
        };
}
---

{
  p.tipo === 'seccion' ? (
    <Base titulo={`${p.seccion.nombre} · ${p.universo.data.nombre}`} descripcion={p.seccion.descripcion} universo={p.universo}>
      <SubNav slot="subnav" universo={p.universo} activo={p.seccion.id} />
      <div class="contenedor">
        <header class="cab-seccion">
          <h1>
            <span class="numero">{p.seccion.nombre}</span>
            {{ cronologico: ' · Orden cronológico', estreno: ' · Por orden de estreno', carpetas: ' · Por carpetas' }[p.seccion.orden]}
          </h1>
          {p.seccion.descripcion && <p>{p.seccion.descripcion}</p>}
        </header>
        <Estanteria
          huecos={p.huecos}
          cronologica={p.seccion.orden !== 'estreno'}
          nombreOrden={p.seccion.orden === 'carpetas' ? 'Por carpetas' : undefined}
          cabeceras={p.cabeceras}
          sagas={p.sagas}
          etiqueta={`Estantería de ${p.seccion.nombre}`}
        />
      </div>
    </Base>
  ) : (
    <Base
      titulo={p.t.d.temporada ? `${p.t.d.titulo} (temporada ${p.t.d.temporada})` : `${p.t.d.titulo} (${p.t.d.anio})`}
      descripcion={descripcionFicha}
      universo={p.universo}
      imagen={imagenSocial}
      tipoOg={p.t.d.tipo === 'serie' ? 'video.tv_show' : 'video.movie'}
      datos={datosFicha}
    >
      <SubNav slot="subnav" universo={p.universo} activo={p.t.d.seccion} />
      <div class="contenedor">
        <Ficha t={p.t} universo={p.universo} sagas={p.sagas} anterior={p.anterior} siguiente={p.siguiente} temporadas={p.temporadas} />
      </div>
    </Base>
  )
}

<style>
  .cab-seccion {
    padding: clamp(22px, 4vw, 36px) 0 18px;
  }
  .cab-seccion h1 .numero {
    color: var(--acento-txt);
  }
  .cab-seccion p {
    color: var(--txt-2);
    margin: 10px 0 0;
  }
</style>
