---
import { conIdiomas, idiomaDe, textos, LOCALE, nombreTipo } from '../../i18n';
export function getStaticPaths() {
  return conIdiomas([{ params: { rankings: 'rankings' } }]);
}
/**
 * Rankings: títulos por nota de TMDB (con filtros de universo, tipo y década, en el navegador) y actores y villanos
 * por número de apariciones, calculados al compilar.
 *
 * Las temporadas de una serie comparten los votos de la serie, así que por separado llenarían la lista:
 * cada serie cuenta una vez, con la media de las notas de sus temporadas.
 */
import Base from '../../layouts/Base.astro';
import GraficoBarras, { type Serie } from '../../components/GraficoBarras.astro';
import AvisoGrafico from '../../components/AvisoGrafico.astro';
import { universosActivos, titulosDe, localizar, type Titulo } from '../../lib/datos';
import { datosTmdb, imagenTmdb } from '../../lib/tmdb';
import { apariciones } from '../../lib/personajes';
import { actores, obraDe } from '../../lib/actores';
import { personajeLoc } from '../../i18n/datos';

/** Con menos votos, la nota dice poco */
const MIN_VOTOS = 100;
/** Filas que se ven antes de pulsar «Ver todos» */
const VISIBLES = 25;

const tx = textos(Astro.url);
const r = tx.rankings;
const idioma = idiomaDe(Astro.url);
const universos = await universosActivos();
const series: Serie[] = universos.map((u) => ({ id: u.id, nombre: u.data.nombre, color: u.data.tema?.acento ?? '#888' }));
const titulos: Titulo[] = (await Promise.all(universos.map((u) => titulosDe(u.id)))).flat();
const nombreUniverso = new Map(universos.map((u) => [u.id, u.data.nombre]));
const decadaDe = (anio: number) => Math.floor(anio / 10) * 10;
const textoDecada = (d: number) => (idioma === 'en' ? `${d}s` : String(d));

// Una entrada por obra: las temporadas de una serie se juntan
const porObra = new Map<string, Titulo[]>();
for (const t of titulos) {
  const d = datosTmdb(t.universo, t.id, 'es');
  if (!d?.nota || (d.votos ?? 0) < MIN_VOTOS) continue;
  const clave = obraDe(t);
  (porObra.get(clave) ?? porObra.set(clave, []).get(clave)!).push(t);
}
const filas = [...porObra.values()]
  .map((lista) => {
    const orden = [...lista].sort((a, b) => a.d.anio - b.d.anio || (a.d.temporada ?? 0) - (b.d.temporada ?? 0));
    const t = localizar(orden[0], idioma);
    const datos = lista.map((x) => datosTmdb(x.universo, x.id, 'es')!);
    return {
      t,
      nombre: t.d.serie ? t.d.titulo : t.corto,
      poster: (datosTmdb(t.universo, t.id, idioma) ?? datos[0]).poster ?? datos[0].poster,
      nota: Math.round((datos.reduce((n, d) => n + d.nota!, 0) / datos.length) * 10) / 10,
      votos: Math.max(...datos.map((d) => d.votos ?? 0)),
      temporadas: lista.length,
    };
  })
  .sort((a, b) => b.nota - a.nota || b.votos - a.votos);

const decadas = [...new Set(filas.map((f) => decadaDe(f.t.d.anio)))].sort((a, b) => a - b);
const tipos = [...new Set(filas.map((f) => f.t.tipo))];

// Actores: contados por títulos, como en Estadísticas
const filasActores = [...(await actores())]
  .sort((a, b) => b.papeles.length - a.papeles.length || a.nombre.localeCompare(b.nombre, LOCALE[idioma]))
  .slice(0, 20)
  .map((a) => ({ etiqueta: a.nombre, url: `/actores/${a.id}/`, partes: universos.map((u) => ({ serie: u.id, valor: a.porUniverso[u.id] ?? 0 })) }));

// Villanos: los personajes marcados con `villano: true`
const { porPersonaje, personajes } = await apariciones();
const filasVillanos = personajes
  .filter((p) => p.data.villano && universos.some((u) => u.id === p.data.universo.id))
  .map((p) => ({ p: personajeLoc(p, idioma), n: porPersonaje.get(p.id)?.length ?? 0 }))
  .sort((a, b) => b.n - a.n || a.p.data.nombre.localeCompare(b.p.data.nombre, LOCALE[idioma]))
  .slice(0, 20)
  .map(({ p, n }) => ({ etiqueta: p.data.nombre, url: `/${p.data.universo.id}/personajes/${p.id}/`, partes: [{ serie: p.data.universo.id, valor: n }] }));

const numero = (n: number) => n.toLocaleString(LOCALE[idioma]);
const textoNota = (n: number) => n.toLocaleString(LOCALE[idioma], { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<Base titulo={r.tituloSeo} descripcion={r.descripcion} migas={[{ nombre: 'Heroteca', url: '/' }, { nombre: r.titulo, url: '/rankings/' }]}>
  <div class="contenedor rankings">
    <h1>{r.titulo}</h1>
    <p class="entradilla">{r.intro}</p>

    <section class="panel bloque" aria-labelledby="t-notas" data-ranking data-visibles={VISIBLES} data-mostrando={r.mostrando('{n}', '{total}')}>
      <h2 id="t-notas">{r.notas}</h2>
      <p class="explica">{r.notasNota(MIN_VOTOS)}</p>

      <form class="filtros">
        <label>
          {r.universo}
          <select data-filtro="universo">
            <option value="">{r.todos}</option>
            {universos.map((u) => <option value={u.id}>{u.data.nombre}</option>)}
          </select>
        </label>
        <label>
          {r.tipo}
          <select data-filtro="tipo">
            <option value="">{r.todos}</option>
            {tipos.map((t) => <option value={t}>{nombreTipo(t, idioma, true)}</option>)}
          </select>
        </label>
        <label>
          {r.decada}
          <select data-filtro="decada">
            <option value="">{r.todas}</option>
            {decadas.map((d) => <option value={d}>{textoDecada(d)}</option>)}
          </select>
        </label>
        <label>
          {r.orden}
          <select data-orden>
            <option value="mejores">{r.mejores}</option>
            <option value="peores">{r.peores}</option>
          </select>
        </label>
      </form>

      <p class="contador" role="status" data-contador>{r.mostrando(Math.min(VISIBLES, filas.length), filas.length)}</p>

      <ol class="lista" data-lista>
        {
          filas.map((f, i) => (
            <li class="fila" hidden={i >= VISIBLES} data-universo={f.t.universo} data-tipo={f.t.tipo} data-decada={decadaDe(f.t.d.anio)}>
              <span class="puesto" aria-hidden="true" data-puesto>
                {i + 1}
              </span>
              {f.poster ? <img src={imagenTmdb(f.poster, 'w92')} alt="" width="46" height="69" loading="lazy" decoding="async" /> : <span class="sin-poster" />}
              <span class="datos">
                <a href={f.t.url}>{f.nombre}</a>
                <span class="meta">
                  {f.t.d.anio} · {nombreTipo(f.t.tipo, idioma)} · {nombreUniverso.get(f.t.universo)}
                  {f.temporadas > 1 && ` · ${r.temporadas(f.temporadas)}`} · {r.votos(numero(f.votos))}
                </span>
              </span>
              <span class="nota">{textoNota(f.nota)}</span>
            </li>
          ))
        }
      </ol>
      <p class="vacio" hidden data-vacio>{r.sinResultados}</p>
      <button type="button" class="pastilla ver-todos" data-ver-todos hidden={filas.length <= VISIBLES}>{r.verTodos}</button>
    </section>

    <div class="dos">
      <section class="panel bloque" aria-labelledby="t-actores">
        <h2 id="t-actores">{r.actores}</h2>
        <p class="explica">{r.actoresNota}</p>
        <GraficoBarras filas={filasActores} series={series} formato={(n) => String(n)} cabecera={r.nombre} etiqueta={r.actores} />
      </section>
      <section class="panel bloque" aria-labelledby="t-villanos">
        <h2 id="t-villanos">{r.villanos}</h2>
        <p class="explica">{r.villanosNota}</p>
        <GraficoBarras filas={filasVillanos} series={series} formato={(n) => String(n)} cabecera={r.nombre} etiqueta={r.villanos} />
      </section>
    </div>
  </div>
  <AvisoGrafico />
</Base>

<script>
  // Filtra y ordena la lista ya escrita en la página; numera solo lo que queda y muestra los primeros
  const caja = document.querySelector<HTMLElement>('[data-ranking]')!;
  const lista = caja.querySelector<HTMLElement>('[data-lista]')!;
  const filas = [...lista.children] as HTMLElement[];
  const filtros = [...caja.querySelectorAll<HTMLSelectElement>('[data-filtro]')];
  const orden = caja.querySelector<HTMLSelectElement>('[data-orden]')!;
  const contador = caja.querySelector<HTMLElement>('[data-contador]')!;
  const vacio = caja.querySelector<HTMLElement>('[data-vacio]')!;
  const verTodos = caja.querySelector<HTMLButtonElement>('[data-ver-todos]')!;
  const visibles = Number(caja.dataset.visibles);
  let todos = false;

  function pintar() {
    const coinciden = filas.filter((f) => filtros.every((s) => !s.value || f.dataset[s.dataset.filtro!] === s.value));
    if (orden.value === 'peores') coinciden.reverse();
    const elegidas = new Set(coinciden);
    lista.replaceChildren(...coinciden, ...filas.filter((f) => !elegidas.has(f)));
    filas.forEach((f) => (f.hidden = true));
    const mostradas = todos ? coinciden : coinciden.slice(0, visibles);
    mostradas.forEach((f, i) => {
      f.hidden = false;
      f.querySelector('[data-puesto]')!.textContent = String(i + 1);
    });
    contador.textContent = (caja.dataset.mostrando ?? '').replace('{n}', String(mostradas.length)).replace('{total}', String(coinciden.length));
    vacio.hidden = coinciden.length > 0;
    verTodos.hidden = mostradas.length === coinciden.length;
  }

  [...filtros, orden].forEach((s) =>
    s.addEventListener('change', () => {
      todos = false;
      pintar();
    }),
  );
  verTodos.addEventListener('click', () => {
    todos = true;
    pintar();
  });
  // El navegador puede recordar los desplegables al volver atrás
  pintar();
</script>

<style>
  .rankings {
    padding-block: clamp(20px, 4vw, 36px) 48px;
  }
  .entradilla {
    max-width: 70ch;
    color: var(--txt-2);
  }
  .bloque {
    margin-top: 18px;
  }
  .bloque h2 {
    margin-top: 0;
  }
  .explica {
    margin: 4px 0 14px;
    font-size: 0.88rem;
    color: var(--txt-2);
  }
  .filtros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .filtros label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .filtros select {
    font: 500 0.92rem var(--f-texto);
    color: var(--txt);
    background: var(--sup);
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 8px 12px;
  }
  .contador {
    margin: 14px 0 6px;
    font-size: 0.88rem;
    color: var(--txt-2);
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fila {
    display: grid;
    grid-template-columns: 2.4em 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid var(--borde);
  }
  .fila[hidden] {
    display: none;
  }
  .puesto {
    text-align: right;
    font: 700 1.1rem var(--f-titulo);
    color: var(--txt-2);
  }
  .fila img,
  .sin-poster {
    display: block;
    width: 46px;
    height: 69px;
    border-radius: 4px;
    background: var(--borde);
    object-fit: cover;
  }
  .datos {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .datos a {
    font-weight: 700;
    color: inherit;
  }
  .meta {
    font-size: 0.82rem;
    color: var(--txt-2);
  }
  .nota {
    font: 800 1.4rem var(--f-titulo);
  }
  .vacio {
    margin: 12px 0 0;
    color: var(--txt-2);
  }
  .ver-todos {
    margin-top: 12px;
  }
  .dos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 18px;
  }
</style>
