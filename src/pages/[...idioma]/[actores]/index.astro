---
import { conIdiomas, idiomaDe, textos } from '../../../i18n';
export function getStaticPaths() {
  return conIdiomas([{ params: { actores: 'actores' } }], () => ({ actores: 'actors' }));
}
/** Índice de actores y actrices: los que tienen página, de más a menos obras, con un filtro por nombre. */
import Base from '../../../layouts/Base.astro';
import { actores, claveActor, limpiarPersonaje, mismoPersonaje } from '../../../lib/actores';
import { imagenTmdb, datosTmdb } from '../../../lib/tmdb';

const tx = textos(Astro.url);
const ta = tx.actores;
const idioma = idiomaDe(Astro.url);
const lista = (await actores()).map((a) => {
  // Personajes más repetidos (en inglés, del reparto inglés si existe)
  const cuenta = new Map<string, number>();
  for (const p of a.papeles) {
    const en = idioma === 'en' ? datosTmdb(p.t.universo, p.t.id, 'en')?.reparto?.find((r) => claveActor(r.actor) === claveActor(a.nombre))?.personaje : undefined;
    const pj = (limpiarPersonaje(en) || p.personaje)?.split(' / ')[0]?.trim();
    const igual = pj && [...cuenta.keys()].find((x) => mismoPersonaje(x, pj));
    if (pj) cuenta.set(igual || pj, (cuenta.get(igual || pj) ?? 0) + 1);
  }
  const personajes = [...cuenta].sort((x, y) => y[1] - x[1]).slice(0, 2).map(([n]) => n);
  return { ...a, personajes };
});
---

<Base
  titulo={ta.tituloSeo}
  descripcion={ta.descripcion}
  migas={[
    { nombre: 'Heroteca', url: '/' },
    { nombre: ta.titulo, url: '/actores/' },
  ]}
>
  <div class="contenedor actores" data-actores>
    <h1>{ta.titulo}</h1>
    <p class="entradilla">{ta.intro(lista.length)}</p>
    <label class="filtro">
      <span class="solo-lectores">{ta.filtrar}</span>
      <input type="search" placeholder={ta.filtrar} data-filtrar autocomplete="off" />
    </label>
    <ul class="lista">
      {
        lista.map((a, i) => (
          <li data-nombre={`${claveActor(a.nombre)} ${a.personajes.map(claveActor).join(' ')}`}>
            <a href={`/actores/${a.id}/`}>
              <span class="foto">
                {a.foto ? (
                  <img src={imagenTmdb(a.foto, 'w92')} alt="" width="92" height="138" loading={i < 12 ? 'eager' : 'lazy'} />
                ) : (
                  <span aria-hidden="true">{a.nombre.split(' ').map((p) => p[0]).slice(0, 2).join('')}</span>
                )}
              </span>
              <span class="texto">
                <span class="nombre">{a.nombre}</span>
                <span class="meta">{ta.obras(a.obras)}</span>
                {a.personajes.length > 0 && <span class="meta">{a.personajes.join(' · ')}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="vacio" data-vacio hidden>{ta.sinResultados}</p>
  </div>
</Base>

<script>
  // Filtro por nombre (también encuentra por personaje)
  const raiz = document.querySelector<HTMLElement>('[data-actores]')!;
  const filas = [...raiz.querySelectorAll<HTMLLIElement>('li[data-nombre]')];
  const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
  const normal = (s: string) =>
    s
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  raiz.querySelector<HTMLInputElement>('[data-filtrar]')?.addEventListener('input', (e) => {
    const q = normal((e.target as HTMLInputElement).value);
    let visibles = 0;
    for (const f of filas) {
      f.hidden = Boolean(q) && !(f.dataset.nombre ?? '').includes(q);
      if (!f.hidden) visibles++;
    }
    vacio.hidden = visibles > 0;
  });
</script>

<style>
  .actores {
    padding-block: clamp(20px, 4vw, 36px) 48px;
  }
  .entradilla {
    max-width: 70ch;
    color: var(--txt-2);
  }
  .filtro input {
    width: min(100%, 360px);
    margin: 10px 0 20px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--borde);
    background: var(--sup);
    color: inherit;
    font-size: 1rem;
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 10px;
  }
  .lista a {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: center;
    padding: 8px;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--sup);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transicion);
  }
  .lista a:hover,
  .lista a:focus-visible {
    border-color: var(--acento);
  }
  .foto {
    display: grid;
    place-items: center;
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: var(--borde);
    font: 800 1rem var(--f-titulo);
    color: var(--txt-2);
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .nombre {
    font-weight: 700;
  }
  .meta {
    font-size: 0.82rem;
    color: var(--txt-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vacio {
    color: var(--txt-2);
  }
</style>
