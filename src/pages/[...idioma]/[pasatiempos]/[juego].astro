---
import { conIdiomas } from '../../../i18n';
import { JUEGOS, textoJuego, type Juego } from '../../../config/juegos';
export function getStaticPaths() {
  return conIdiomas(
    JUEGOS.map((j) => ({ params: { pasatiempos: 'pasatiempos', juego: j.id as string }, props: { juego: j } })),
    (r) => ({ pasatiempos: 'games', juego: (r.props as { juego: Juego }).juego.idEn }),
  );
}
/** Página de un pasatiempo: prepara los datos que necesita cada juego (personajes o títulos) y lo muestra. */
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import BotonVolver from '../../../components/BotonVolver.astro';
import JuegoAdivina, { type PersonajeJuego } from '../../../components/JuegoAdivina.astro';
import JuegoQuienEres from '../../../components/JuegoQuienEres.astro';
import JuegoCualAntes, { type TituloJuego } from '../../../components/JuegoCualAntes.astro';
import JuegoHeroedle, { type PersonajeHeroedle } from '../../../components/JuegoHeroedle.astro';
import JuegoPixelado, { type CartelJuego } from '../../../components/JuegoPixelado.astro';
import JuegoOrdena, { type TituloOrden } from '../../../components/JuegoOrdena.astro';
import JuegoInterpretes, { type ParejaInterprete } from '../../../components/JuegoInterpretes.astro';
import JuegoConecta, { type DatosConecta } from '../../../components/JuegoConecta.astro';
import JuegoTrivia, { type PeliculaTrivia } from '../../../components/JuegoTrivia.astro';
import JuegoBingo from '../../../components/JuegoBingo.astro';
import { actores, obraDe } from '../../../lib/actores';
import { LINEA_TEMPORAL, leerEpoca } from '../../../lib/lineaTemporal';
import { universosActivos, todosLosTitulos, huecosDeSeccion, localizar, type Titulo } from '../../../lib/datos';
import { apariciones } from '../../../lib/personajes';
import { imagenTmdb, datosTmdb } from '../../../lib/tmdb';
import { textos, idiomaDe, LOCALE } from '../../../i18n';
import { rutaEnIdioma } from '../../../i18n/rutas';
import { personajeLoc } from '../../../i18n/datos';

const { juego } = Astro.props as { juego: Juego };
const tx = textos(Astro.url);
const j = tx.juegos;
const idioma = idiomaDe(Astro.url);
const universos = await universosActivos();
const activos = new Map(universos.map((u) => [u.id, u]));
const { nombre, texto } = textoJuego(j, juego.clave);

// «Adivina el personaje»: los que salen en al menos 4 títulos
let personajes: PersonajeJuego[] = [];
if (juego.clave === 'adivina') {
  const { personajes: todos, porPersonaje } = await apariciones();
  personajes = await Promise.all(
    todos
      .filter((p) => activos.has(p.data.universo.id) && (porPersonaje.get(p.id)?.length ?? 0) >= 4)
      .map(async (original) => {
        const p = personajeLoc(original, idioma);
        const aps = porPersonaje.get(p.id) ?? [];
        const actores = new Map<string, number>();
        for (const a of aps) if (a.actor) actores.set(a.actor, (actores.get(a.actor) ?? 0) + 1);
        return {
          id: p.id,
          n: p.data.nombre,
          u: p.data.universo.id,
          un: activos.get(p.data.universo.id)!.data.nombre,
          url: await rutaEnIdioma(`/${p.data.universo.id}/personajes/${p.id}/`, idioma),
          t: aps.length,
          a: Math.min(...aps.map((a) => a.titulo.d.anio)),
          tit: [...new Set(aps.map((a) => localizar(a.titulo, idioma).corto))].slice(0, 8),
          act: [...actores].sort((x, y) => y[1] - x[1]).slice(0, 3).map(([n]) => n),
          ide: p.data.identidad && p.data.identidad !== p.data.nombre ? p.data.identidad : undefined,
        };
      }),
  );
}

// Heroedle: los mismos personajes, con sus datos comparables
let heroedle: PersonajeHeroedle[] = [];
if (juego.clave === 'heroedle') {
  const { personajes: todos, porPersonaje } = await apariciones();
  heroedle = await Promise.all(
    todos
      .filter((p) => activos.has(p.data.universo.id) && (porPersonaje.get(p.id)?.length ?? 0) >= 4)
      .map(async (original) => {
        const p = personajeLoc(original, idioma);
        const aps = porPersonaje.get(p.id) ?? [];
        return {
          id: p.id,
          n: p.data.nombre,
          u: activos.get(p.data.universo.id)!.data.nombre,
          a: Math.min(...aps.map((a) => a.titulo.d.anio)),
          t: aps.length,
          i: new Set(aps.map((a) => a.actor).filter(Boolean)).size,
          url: await rutaEnIdioma(`/${p.data.universo.id}/personajes/${p.id}/`, idioma),
        };
      }),
  );
}

// ¿Quién lo interpretó?: personajes con un intérprete claro (al menos 3 títulos con el mismo)
let parejas: ParejaInterprete[] = [];
if (juego.clave === 'interpretes') {
  const { personajes: todos, porPersonaje } = await apariciones();
  const lista = todos.filter((p) => activos.has(p.data.universo.id)).map((original) => {
    const cuenta = new Map<string, number>();
    for (const a of porPersonaje.get(original.id) ?? []) if (a.actor) cuenta.set(a.actor, (cuenta.get(a.actor) ?? 0) + 1);
    const [actor, veces] = [...cuenta].sort((x, y) => y[1] - x[1])[0] ?? ['', 0];
    return { original, actor, veces };
  });
  parejas = await Promise.all(
    lista
      .filter((x) => x.veces >= 3)
      .map(async (x) => ({
        p: personajeLoc(x.original, idioma).data.nombre,
        a: x.actor,
        url: await rutaEnIdioma(`/${x.original.data.universo.id}/personajes/${x.original.id}/`, idioma),
      })),
  );
}

// Los juegos de títulos: películas y primeras temporadas con imagen (de la colección o de TMDB)
const titulosConImagen = ['antes', 'duelo', 'pixelado', 'ordena'].includes(juego.clave)
  ? (await todosLosTitulos(idioma)).filter((t) => activos.has(t.universo) && (t.portada || t.m.posterTmdb) && (t.d.temporada ?? 1) === 1)
  : [];
const imagen = async (t: Titulo, ancho: 'w185' | 'w342') =>
  t.portada ? (await getImage({ src: t.portada, width: ancho === 'w185' ? 185 : 342, format: 'webp' })).src : imagenTmdb(t.m.posterTmdb!, ancho);
const votosDe = (t: Titulo) => datosTmdb(t.universo, t.id, 'es')?.votos ?? 0;

// ¿Cuál se estrenó antes?: gana la fecha menor
let titulosJuego: TituloJuego[] = [];
if (juego.clave === 'antes') {
  titulosJuego = await Promise.all(
    titulosConImagen.map(async (t) => {
      const f = t.m.fecha ? t.m.fecha.toISOString().slice(0, 10) : `${t.d.anio}-06-30`;
      return { n: t.corto, v: Number(f.replaceAll('-', '')), vt: f.slice(0, 4), img: await imagen(t, 'w185'), url: await rutaEnIdioma(t.url, idioma) };
    }),
  );
}
// Duelo de notas: títulos con al menos 500 votos (notas fiables); gana la mayor
if (juego.clave === 'duelo') {
  titulosJuego = await Promise.all(
    titulosConImagen
      .filter((t) => votosDe(t) >= 500)
      .map(async (t) => {
        const nota = datosTmdb(t.universo, t.id, 'es')!.nota ?? 0;
        return { n: t.corto, v: nota, vt: `★ ${nota.toLocaleString(LOCALE[idioma], { minimumFractionDigits: 1 })}`, img: await imagen(t, 'w185'), url: await rutaEnIdioma(t.url, idioma) };
      }),
  );
}
// Cartel pixelado: títulos conocidos (al menos 1000 votos) sin repetir nombre
let carteles: CartelJuego[] = [];
if (juego.clave === 'pixelado') {
  carteles = await Promise.all(
    titulosConImagen.filter((t) => votosDe(t) >= 1000).map(async (t) => ({ n: t.corto, img: await imagen(t, 'w342'), url: await rutaEnIdioma(t.url, idioma) })),
  );
  carteles = carteles.filter((c, i) => carteles.findIndex((x) => x.n === c.n) === i);
}
// Ordena la cronología: las películas del UMC, con su puesto en el orden de la colección
let paraOrdenar: TituloOrden[] = [];
if (juego.clave === 'ordena') {
  const marvel = universos.find((u) => u.id === LINEA_TEMPORAL.universo);
  const seccion = marvel?.data.secciones.find((s) => s.id === LINEA_TEMPORAL.seccion);
  if (seccion) {
    const enOrden: Titulo[] = [];
    for (const h of huecosDeSeccion(titulosConImagen.filter((t) => t.universo === marvel!.id && t.d.seccion === seccion.id), seccion)) if (!enOrden.includes(h.titulo)) enOrden.push(h.titulo);
    paraOrdenar = await Promise.all(
      enOrden
        .map((t, p) => ({ t, p }))
        // Con año conocido y del universo principal (estas dos transcurren en otros universos)
        .filter(({ t }) => t.tipo === 'pelicula' && leerEpoca(t.d.epoca) && !['los-cuatro-fantasticos-primeros-pasos', 'deadpool-y-wolverine'].includes(t.id))
        .map(async ({ t, p }) => ({ n: t.corto, p, e: leerEpoca(t.d.epoca)?.texto, url: await rutaEnIdioma(t.url, idioma) })),
    );
  }
}

// Conecta a los actores: quienes tienen página y las obras que comparten al menos dos (sin cameos)
let conecta: DatosConecta = { a: [], o: [], c: [] };
if (juego.clave === 'conecta') {
  const lista = await actores();
  const obras = new Map<string, { n: string; r: Set<number> }>();
  lista.forEach((a, i) => {
    for (const { t } of a.papeles) {
      const l = localizar(t, idioma);
      const obra = obras.get(obraDe(t)) ?? { n: l.d.serie ? l.corto.split(' · ')[0] : l.corto, r: new Set<number>() };
      obra.r.add(i);
      obras.set(obraDe(t), obra);
    }
  });
  conecta = {
    a: await Promise.all(lista.map(async (a) => ({ n: a.nombre, u: await rutaEnIdioma(`/actores/${a.id}/`, idioma) }))),
    o: [...obras.values()].filter((o) => o.r.size >= 2).map((o) => ({ n: o.n, r: [...o.r] })),
    // Las parejas salen de quienes tienen al menos 5 obras: dos desconocidos no son divertidos
    c: lista.flatMap((a, i) => (a.obras >= 5 ? [i] : [])),
  };
}

// Trivia diaria: películas con al menos 300 votos, de 60 minutos o más para preguntar la duración, y con la dirección
// de TMDB (nombres completos e iguales en toda la lista), solo si son una o dos personas. De las escenas, solo lo seguro: dos momentos confirmados, o una
// escena con fuente en la ficha (las palabras clave de TMDB a veces omiten una: «solo durante» no sería fiable)
let trivia: PeliculaTrivia[] = [];
if (juego.clave === 'trivia') {
  trivia = await Promise.all(
    (await todosLosTitulos(idioma))
      .filter((t) => activos.has(t.universo) && t.tipo === 'pelicula' && votosDe(t) >= 300)
      .map(async (t) => {
        const momentos = (['durante', 'despues'] as const).filter((m) => t.m.escenasCreditos.includes(m) || t.d.conexiones.postCreditos.some((e) => e.momento === m));
        const segura = momentos.length === 2 || (momentos.length === 1 && t.d.conexiones.postCreditos.length > 0);
        const direccion = datosTmdb(t.universo, t.id, 'es')?.direccion ?? t.m.direccion;
        return {
          id: t.id,
          n: t.corto,
          a: t.d.anio,
          url: await rutaEnIdioma(t.url, idioma),
          d: (t.m.duracion ?? 0) >= 60 ? t.m.duracion : undefined,
          r: direccion.length >= 1 && direccion.length <= 2 ? direccion : undefined,
          e: segura ? momentos : undefined,
        };
      }),
  );
}
---

<Base
  titulo={`${nombre} · ${j.titulo}`}
  descripcion={texto}
  migas={[
    { nombre: 'Heroteca', url: '/' },
    { nombre: j.titulo, url: '/pasatiempos/' },
    { nombre, url: `/pasatiempos/${juego.id}/` },
  ]}
>
  <div class="contenedor pagina-juego">
    <BotonVolver href="/pasatiempos/">
      <nav class="miga" aria-label={tx.general.estasEn}><a href="/pasatiempos/">{j.titulo}</a></nav>
    </BotonVolver>
    <h1>{nombre}</h1>
    <p class="entradilla">{texto}</p>
    {juego.clave === 'adivina' && <JuegoAdivina personajes={personajes} />}
    {juego.clave === 'quien' && <JuegoQuienEres />}
    {juego.clave === 'antes' && <JuegoCualAntes titulos={titulosJuego} />}
    {juego.clave === 'duelo' && <JuegoCualAntes titulos={titulosJuego} modo="nota" />}
    {juego.clave === 'heroedle' && <JuegoHeroedle personajes={heroedle} />}
    {juego.clave === 'pixelado' && <JuegoPixelado carteles={carteles} />}
    {juego.clave === 'ordena' && <JuegoOrdena titulos={paraOrdenar} />}
    {juego.clave === 'interpretes' && <JuegoInterpretes parejas={parejas} />}
    {juego.clave === 'conecta' && <JuegoConecta datos={conecta} />}
    {juego.clave === 'trivia' && <JuegoTrivia peliculas={trivia} />}
    {juego.clave === 'bingo' && <JuegoBingo />}
  </div>
</Base>

<style>
  .pagina-juego {
    padding-bottom: 48px;
  }
  h1 {
    margin-top: 6px;
  }
  .entradilla {
    max-width: 70ch;
    color: var(--txt-2);
    margin-bottom: 20px;
  }
</style>
