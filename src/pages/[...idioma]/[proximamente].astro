---
import { conIdiomas, idiomaDe, textos, LOCALE } from '../../i18n';
export function getStaticPaths() {
  return conIdiomas([{ params: { proximamente: 'proximamente' } }], () => ({ proximamente: 'coming-soon' }));
}
/**
 * «Próximamente»: próximos estrenos de Marvel y DC (datos/proximamente.json, actualizado cada semana).
 * Arriba, las series en emisión con su próximo episodio; debajo, los estrenos por año. Se puede filtrar por universo.
 */
import Base from '../../layouts/Base.astro';
import TarjetaEstreno from '../../components/TarjetaEstreno.astro';
import ListaEstrenos from '../../components/ListaEstrenos.astro';
import { universosActivos } from '../../lib/datos';
import { proximosEstrenos, enEmision, fechaProximamente, textosEstreno, fechaDe } from '../../lib/proximamente';
import { paisDe } from '../../lib/dondever';

const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);
const universos = await universosActivos();
const uDe = (id: string) => universos.find((u) => u.id === id);
const pais = paisDe(idioma);
const lista = proximosEstrenos(pais).filter((e) => uDe(e.universo));
const emision = lista.filter(enEmision);
const estrenos = lista.filter((e) => !enEmision(e));
const anios = [...new Set(estrenos.map((e) => fechaDe(e, pais).slice(0, 4)))];
const actualizado = fechaProximamente().toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  titulo={tx.proximos.tituloSeo}
  descripcion={tx.proximos.descripcion}
  migas={[{ nombre: 'Heroteca', url: '/' }, { nombre: tx.proximos.titulo, url: '/proximamente/' }]}
  datos={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: tx.proximos.estrenos,
    itemListElement: estrenos.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: textosEstreno(e, idioma).titulo })),
  }}
>
  <div class="contenedor proximos" data-proximos>
    <h1>{tx.proximos.titulo}</h1>
    <p class="entradilla">{tx.proximos.intro} {tx.proximos.actualizado(actualizado)}</p>

    {
      universos.length > 1 && (
        <div class="filtro" role="group" aria-label={tx.proximos.universo}>
          <button type="button" class="pastilla" data-filtro="" aria-pressed="true">
            {tx.proximos.todos}
          </button>
          {universos.map((u) => (
            <button type="button" class="pastilla" data-filtro={u.id} aria-pressed="false">
              {u.data.nombre}
            </button>
          ))}
        </div>
      )
    }

    {
      emision.length > 0 && (
        <section data-bloque aria-labelledby="t-emision">
          <h2 id="t-emision">{tx.proximos.enEmision}</h2>
          <ListaEstrenos>
            {emision.map((e) => (
              <TarjetaEstreno e={e} u={uDe(e.universo)} />
            ))}
          </ListaEstrenos>
        </section>
      )
    }

    <section aria-labelledby="t-estrenos">
      <h2 id="t-estrenos">{tx.proximos.estrenos}</h2>
      {
        anios.map((a) => (
          <section data-bloque aria-labelledby={`t-${a}`}>
            <h3 id={`t-${a}`} class="anio">{a}</h3>
            <ListaEstrenos>
              {estrenos
                .filter((e) => fechaDe(e, pais).startsWith(a))
                .map((e) => (
                  <TarjetaEstreno e={e} u={uDe(e.universo)} conSinopsis />
                ))}
            </ListaEstrenos>
          </section>
        ))
      }
      <p class="nada" data-nada hidden={estrenos.length > 0}>{tx.proximos.nada}</p>
    </section>
  </div>
</Base>

<script>
  // Filtro por universo (los estrenos ya pasados siguen ocultos: los marca ListaEstrenos con data-pasado)
  const raiz = document.querySelector<HTMLElement>('[data-proximos]');
  const botones = raiz?.querySelectorAll<HTMLButtonElement>('[data-filtro]') ?? [];
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const filtro = b.dataset.filtro ?? '';
      botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      raiz?.querySelectorAll<HTMLElement>('.estreno').forEach((li) => {
        li.hidden = li.dataset.pasado !== undefined || (filtro !== '' && li.dataset.universo !== filtro);
      });
      raiz?.querySelectorAll<HTMLElement>('[data-bloque]').forEach((s) => {
        s.hidden = !s.querySelector('.estreno:not([hidden])');
      });
      const nada = raiz?.querySelector<HTMLElement>('[data-nada]');
      if (nada) nada.hidden = Boolean(raiz?.querySelector('[data-bloque]:not([hidden]) .estreno:not([hidden])'));
    }),
  );
</script>

<style>
  .proximos {
    padding-block: clamp(20px, 4vw, 36px) 48px;
  }
  .entradilla {
    max-width: 70ch;
    color: var(--txt-2);
  }
  .filtro {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 8px;
  }
  h2 {
    margin: 32px 0 16px;
  }
  .anio {
    margin: 24px 0 14px;
    font: 800 1.6rem var(--f-titulo);
    color: var(--txt-2);
  }
  .nada {
    color: var(--txt-2);
  }
</style>
