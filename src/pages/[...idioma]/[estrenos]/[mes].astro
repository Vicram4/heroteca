---
/**
 * /estrenos/<mes>-<año>/ (PaginaEstrenosMes) y /estrenos/<año>/ (PaginaEstrenosAnio) comparten esta ruta:
 * los parámetros no se pisan («diciembre-2026» frente a «2027»).
 */
import { conIdiomas } from '../../../i18n';
import { mesesConEstrenos, rutaMes } from '../../../lib/estrenosMes';
import { aniosConEstrenos } from '../../../lib/estrenosAnio';
import PaginaEstrenosMes from '../../../components/PaginaEstrenosMes.astro';
import PaginaEstrenosAnio from '../../../components/PaginaEstrenosAnio.astro';

type Props = { m: string; anio?: undefined } | { anio: string; m?: undefined };

export async function getStaticPaths() {
  const meses = mesesConEstrenos().map((m) => ({ params: { estrenos: 'estrenos', mes: rutaMes(m, 'es') }, props: { m } as Props }));
  const anios = (await aniosConEstrenos()).map((anio) => ({ params: { estrenos: 'estrenos', mes: anio }, props: { anio } as Props }));
  return conIdiomas([...meses, ...anios], (r) => {
    const p = r.props as Props;
    return { estrenos: 'releases', mes: p.m ? rutaMes(p.m, 'en') : p.anio };
  });
}

const p = Astro.props as Props;
---

{p.m ? <PaginaEstrenosMes m={p.m} /> : <PaginaEstrenosAnio anio={p.anio!} />}
