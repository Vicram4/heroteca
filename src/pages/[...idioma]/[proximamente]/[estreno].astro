---
import { conIdiomas, idiomaDe, textos, LOCALE, nombreTipo } from '../../../i18n';
import { todosLosEstrenos, type Estreno } from '../../../lib/proximamente';
export function getStaticPaths() {
  return conIdiomas(
    todosLosEstrenos().map((e) => ({ params: { proximamente: 'proximamente', estreno: e.ruta.es }, props: { e } })),
    (r) => ({ proximamente: 'coming-soon', estreno: (r.props as { e: Estreno }).e.ruta.en }),
  );
}
/**
 * Página de un próximo estreno, generada a partir de datos/proximamente.json: cuenta atrás, sinopsis, tráiler y datos.
 * Si el título ya está en la colección, redirige a su ficha. Lo que ya se estrenó o dejó de tener fecha conserva su
 * página con un aviso, para no dejar enlaces rotos.
 */
import Base from '../../../layouts/Base.astro';
import CuentaAtras from '../../../components/CuentaAtras.astro';
import ListaEstrenos from '../../../components/ListaEstrenos.astro';
import TarjetaEstreno from '../../../components/TarjetaEstreno.astro';
import Trailer from '../../../components/Trailer.astro';
import { universosActivos, estiloUniverso } from '../../../lib/datos';
import { enEmision, estadoEstreno, enlaceEstreno, enlaceTmdb, fechaDe, fechaProximamente, proximosEstrenos, textosEstreno } from '../../../lib/proximamente';
import { paisDe } from '../../../lib/dondever';
import { imagenTmdb } from '../../../lib/tmdb';
import { rutaEnIdioma } from '../../../i18n/rutas';
import { universoLoc } from '../../../i18n/datos';
import { GUIAS, guiaLoc } from '../../../config/guias';
import { EXTRAS_ESTRENOS } from '../../../config/estrenos';
import Spoiler from '../../../components/Spoiler.astro';
import { SITE } from '../../../config/site';
import AvisosCalendario from '../../../components/AvisosCalendario.astro';

const { e } = Astro.props as { e: Estreno };
const idioma = idiomaDe(Astro.url);
if (e.ficha) return Astro.redirect(await rutaEnIdioma(`/${e.ficha}/`, idioma));

const tx = textos(Astro.url);
const p = tx.proximos;
const pais = paisDe(idioma);
const x = textosEstreno(e, idioma);
const universos = await universosActivos();
const uBase = universos.find((u) => u.id === e.universo);
const u = uBase && universoLoc(uBase, idioma);
const estado = estadoEstreno(e, pais);
const larga = (dia: string) => new Date(`${dia}T00:00:00Z`).toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dia = fechaDe(e, pais);
const tipoTexto = e.tipo === 'pelicula' ? nombreTipo('pelicula', idioma) : enEmision(e) ? p.enEmision : (e.temporada ?? 1) > 1 ? p.temporadaNueva(e.temporada ?? 1) : p.serieNueva;
const masEstrenos = proximosEstrenos(pais, e.universo)
  .filter((o) => o.clave !== e.clave)
  .slice(0, 4);
// Guía «Qué ver antes de…» asociada a este estreno, si la hay (campo antesDe en config/guias.ts)
const guiaBase = e.tmdb ? GUIAS.find((g) => g.antesDe === e.tmdb.id) : undefined;
const guiaAntes = guiaBase && guiaLoc(guiaBase, idioma);
// Preguntas rápidas (solo películas): fecha, duración, escenas poscréditos (config/estrenos.ts) y qué ver antes
const esPeli = e.tipo === 'pelicula';
const extra = EXTRAS_ESTRENOS[e.tmdb.id] ?? {};
const pos = extra.postCreditos;
const escenasPos = pos ? (idioma === 'en' ? pos.en : pos.es) ?? [] : [];
const respuestaPos = pos ? (pos.escenas === 0 ? p.faqPosNo : p.faqPosSi(pos.escenas)) : estado === 'proximo' ? p.faqPosAntes : p.faqPosSinDatos;
const cuando = p.faqCuandoR(e.cines?.ES ? larga(e.cines.ES) : '', e.cines?.US ? larga(e.cines.US) : '') ;
const respuestaCuando = e.cines?.ES || e.cines?.US ? cuando : p.faqCuandoR(larga(dia), '');
const respuestaDura = e.duracion ? p.faqDuraR(Math.floor(e.duracion / 60), e.duracion % 60, e.duracion, estado === 'proximo') : p.faqDuraNo;
// «Ponlo en tu web»: código <iframe> de la cuenta atrás insertable ([insertar]/[estreno].astro)
const rutaInsertar = idioma === 'en' ? `/en/embed/${e.ruta.en}/` : `/insertar/${e.ruta.es}/`;
const codigoInsertar = `<iframe src="${new URL(rutaInsertar, SITE.url).href}" title="${p.insertarIframe(x.titulo).replace(/"/g, '&quot;')}" width="100%" height="200" style="border:0;max-width:560px;border-radius:14px" loading="lazy"></iframe>`;
const actualizado = larga(fechaProximamente().toISOString().slice(0, 10));
---

<Base
  titulo={esPeli ? p.tituloEstrenoPeli(x.titulo) : p.tituloEstreno(x.titulo)}
  descripcion={x.sinopsis || p.descEstreno(x.titulo, larga(dia))}
  universo={uBase}
  imagen={x.poster ? imagenTmdb(x.poster, 'w780') : undefined}
  tipoOg={e.tipo === 'pelicula' ? 'video.movie' : 'video.tv_show'}
  noIndexar={!x.sinopsis || estado === 'sinFecha'}
  migas={[{ nombre: 'Heroteca', url: '/' }, { nombre: p.titulo, url: '/proximamente/' }, { nombre: x.titulo, url: enlaceEstreno(e) }]}
  datos={{
    '@context': 'https://schema.org',
    '@type': e.tipo === 'pelicula' ? 'Movie' : 'TVSeries',
    name: x.titulo,
    ...(x.sinopsis ? { description: x.sinopsis } : {}),
    ...(x.poster ? { image: imagenTmdb(x.poster, 'w780') } : {}),
    ...(estado === 'sinFecha' ? {} : { datePublished: dia }),
    ...(e.duracion ? { duration: `PT${Math.floor(e.duracion / 60)}H${e.duracion % 60}M` } : {}),
  }}
>
  <div class="contenedor estreno-pagina" style={estiloUniverso(uBase)}>
    {
      estado === 'proximo' ? (
        <CuentaAtras e={e} u={uBase} propia />
      ) : (
        <header class="cab">
          {x.poster && <img src={imagenTmdb(x.poster, 'w342')} alt="" width="342" height="513" decoding="async" />}
          <div>
            <h1>{x.titulo}</h1>
            <p class="aviso">{estado === 'estrenado' ? p.estrenadoAviso : p.sinFechaAviso}</p>
          </div>
        </header>
      )
    }

    <section class="panel">
      <h2 class="h-panel">{p.sinopsis}</h2>
      <p>{x.sinopsis || p.sinSinopsis}</p>
    </section>

    {
      guiaAntes && (
        <section class="panel">
          <h2 class="h-panel">{p.antesDeVerla}</h2>
          <p><a href={`/${guiaAntes.universo}/guias/${guiaAntes.id}/`}>{guiaAntes.titulo} →</a></p>
          <p class="nota">{guiaAntes.descripcion}</p>
        </section>
      )
    }

    {
      x.trailer && (
        <section class="panel">
          <h2 class="h-panel">{p.trailer}</h2>
          <Trailer id={x.trailer} titulo={x.titulo} fondo={x.fondo ?? undefined} />
        </section>
      )
    }

    <section class="panel">
      <h2 class="h-panel">{p.datos}</h2>
      <dl class="datos">
        {u && <><dt>{p.universoDato}</dt><dd>{u.data.nombre}</dd></>}
        <dt>{p.tipoDato}</dt><dd>{tipoTexto}</dd>
        {
          e.cines?.ES || e.cines?.US ? (
            <>
              {e.cines?.ES && <><dt>{p.cinesEspana}</dt><dd><time datetime={e.cines.ES}>{larga(e.cines.ES)}</time></dd></>}
              {e.cines?.US && <><dt>{p.cinesEeuu}</dt><dd><time datetime={e.cines.US}>{larga(e.cines.US)}</time></dd></>}
            </>
          ) : (
            <><dt>{estado === 'sinFecha' ? p.fechaUltima : p.fechaDato}</dt><dd><time datetime={dia}>{larga(dia)}</time></dd></>
          )
        }
      </dl>
      <p class="nota">{p.nota(actualizado)}</p>
      <p class="nota"><a href={enlaceTmdb(e, idioma)} rel="noopener">{p.enTmdb} ↗</a></p>
    </section>

    {
      esPeli && estado !== 'sinFecha' && (
        <section class="panel faq">
          <h2 class="h-panel">{p.faq}</h2>
          <h3>{p.faqCuando(x.titulo)}</h3>
          <p>{respuestaCuando}</p>
          <h3>{p.faqDura(x.titulo)}</h3>
          <p>{respuestaDura}</p>
          <h3>{p.faqPos(x.titulo)}</h3>
          <p>{respuestaPos}</p>
          {escenasPos.map((texto, i) => (
            <Spoiler que={p.faqPosEscena(i + 1)}>
              <p>{texto}</p>
            </Spoiler>
          ))}
          {
            guiaAntes && (
              <>
                <h3>{p.faqAntes(x.titulo)}</h3>
                <p>
                  {p.faqAntesR} <a href={`/${guiaAntes.universo}/guias/${guiaAntes.id}/`}>{guiaAntes.titulo}</a>.
                </p>
              </>
            )
          }
        </section>
      )
    }

    {estado === 'proximo' && <AvisosCalendario e={e} />}

    {
      estado === 'proximo' && (
        <section class="panel insertar" aria-labelledby="t-insertar">
          <h2 class="h-panel" id="t-insertar">{p.insertarTitulo}</h2>
          <p class="nota">{p.insertarAyuda}</p>
          <iframe src={rutaInsertar} title={p.insertarIframe(x.titulo)} width="100%" height="200" loading="lazy"></iframe>
          <textarea readonly rows="3" aria-label={p.insertarTitulo} data-codigo>{codigoInsertar}</textarea>
          <button type="button" class="pastilla" data-copiar data-hecho={p.insertarCopiado}>{p.insertarCopiar}</button>
        </section>
      )
    }

    {
      masEstrenos.length > 0 && (
        <section class="mas" data-bloque>
          <h2>{u ? p.masDe(u.data.nombre) : p.estrenos}</h2>
          <ListaEstrenos>
            {masEstrenos.map((o) => <TarjetaEstreno e={o} u={uBase} />)}
          </ListaEstrenos>
          <p class="todos"><a href="/proximamente/">{p.verTodos}</a></p>
        </section>
      )
    }
  </div>
</Base>

<script>
  // Copiar el código de «Ponlo en tu web»
  document.querySelectorAll<HTMLButtonElement>("[data-copiar]").forEach((b) => {
    const area = b.parentElement!.querySelector<HTMLTextAreaElement>("[data-codigo]")!;
    const texto = b.textContent;
    b.addEventListener("click", async () => {
      area.select();
      try {
        await navigator.clipboard.writeText(area.value);
      } catch {
        document.execCommand("copy");
      }
      b.textContent = b.dataset.hecho ?? texto;
      setTimeout(() => (b.textContent = texto), 2000);
    });
  });
</script>

<style>
  .insertar iframe {
    display: block;
    max-width: 560px;
    border: 0;
    border-radius: 14px;
    margin: 10px 0;
  }
  .insertar textarea {
    box-sizing: border-box;
    width: 100%;
    font: 0.8rem/1.4 ui-monospace, Consolas, monospace;
    padding: 8px 10px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--sup);
    color: var(--txt);
    resize: vertical;
    margin-bottom: 8px;
  }
  .estreno-pagina {
    display: grid;
    gap: 20px;
    padding-block: clamp(20px, 4vw, 36px) 48px;
  }
  .estreno-pagina > * {
    min-width: 0;
  }
  .cab {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 28px);
  }
  .cab img {
    flex: none;
    width: clamp(96px, 16vw, 170px);
    height: auto;
    border-radius: var(--radio);
  }
  .cab .aviso {
    margin: 10px 0 0;
    max-width: 60ch;
    color: var(--txt-2);
  }
  .panel p {
    max-width: 70ch;
  }
  .faq h3 {
    margin: 18px 0 4px;
    font: 700 1.05rem var(--f-titulo);
  }
  .faq h3:first-of-type {
    margin-top: 6px;
  }
  .faq p {
    margin: 0;
  }
  .datos {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7px 16px;
    margin: 0;
  }
  .datos dt {
    color: var(--txt-2);
  }
  .datos dd {
    margin: 0;
    font-weight: 500;
  }
  .nota {
    margin: 12px 0 0;
    font-size: 0.88rem;
    color: var(--txt-2);
  }
  .mas h2 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }
  .todos {
    margin: 14px 0 0;
  }
</style>
