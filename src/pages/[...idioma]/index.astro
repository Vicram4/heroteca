---
import { conIdiomas } from '../../i18n';
export function getStaticPaths() {
  return conIdiomas([{ params: {} }]);
}
/** Portada: elegir universo. Se genera sola a partir de contenido/universos/. */
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { comprobarIntegridad } from '../../lib/integridad';
import { todosLosUniversos, titulosDe, estiloUniverso } from '../../lib/datos';
import Caratula from '../../components/Caratula.astro';
import { textos, idiomaDe } from '../../i18n';
import { seccionLoc } from '../../i18n/datos';
import TarjetaEstreno from '../../components/TarjetaEstreno.astro';
import ListaEstrenos from '../../components/ListaEstrenos.astro';
import { proximosEstrenos, enEmision } from '../../lib/proximamente';
import { guiasDe, guiaLoc } from '../../config/guias';
import { paisDe } from '../../lib/dondever';
const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);

await comprobarIntegridad();
const universos = (await todosLosUniversos()).filter((u) => u.data.activo || u.data.proximamente);
const tarjetas = await Promise.all(
  universos.map(async (u) => {
    const titulos = u.data.activo ? await titulosDe(u.id, idioma) : [];
    // Mosaico: la imagen principal de los primeros títulos de la primera sección, en el orden de la colección
    const mosaico = titulos
      .filter((t) => (t.portada || t.m.posterTmdb) && t.d.seccion === u.data.secciones[0]?.id)
      .sort((a, b) => (a.d.numero ?? 999) - (b.d.numero ?? 999))
      .slice(0, 12);
    return { u, total: titulos.length, mosaico };
  }),
);
// Próximos estrenos (sin las series en emisión): los 4 primeros de los universos activos
const activos = universos.filter((u) => u.data.activo);
const proximos = proximosEstrenos(paisDe(idioma))
  .filter((e) => !enEmision(e) && activos.some((u) => u.id === e.universo))
  .slice(0, 4);
// Guías para empezar (todas menos las de carpetas, que son muy específicas)
const guiasPortada = activos.flatMap((u) => guiasDe(u.id).filter((g) => g.tipo !== 'carpetas').map((g) => ({ u, g: guiaLoc(g, idioma) })));
---

<Base
  descripcion={tx.portada.descripcion}
  datos={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nombre,
    alternateName: tx.lema,
    url: SITE.url,
    inLanguage: tx.idioma,
    description: tx.descripcion,
  }}
>
  <section class="contenedor portada">
    <h1 class="solo-lectores">{SITE.nombre}</h1>
    <p class="intro">{tx.general.eligeUniverso}</p>
    <div class="universos" style={`--n:${tarjetas.length}`}>
      {
        tarjetas.map(({ u, total, mosaico }, i) =>
          u.data.activo ? (
            <a href={`/${u.id}/`} class="universo" style={estiloUniverso(u)}>
              <span class="mosaico" aria-hidden="true">
                {mosaico.map((t) => (
                  <Caratula t={t} ancho={100} cargaInmediata={i === 0} />
                ))}
              </span>
              <span class="texto">
                <span class="nombre">{u.data.nombre}</span>
                <span class="secciones">{u.data.secciones.map((s) => seccionLoc(s, idioma).nombre).join(' · ')}</span>
                <span class="total">{tx.general.titulos(total)}</span>
              </span>
            </a>
          ) : (
            <div class="universo pronto" style={estiloUniverso(u)}>
              <span class="texto">
                <span class="nombre">{u.data.nombre}</span>
                <span class="secciones">{u.data.descripcion}</span>
                <span class="etiqueta-pronto">{tx.general.proximamente}</span>
              </span>
            </div>
          ),
        )
      }
    </div>
  </section>

  <section class="contenedor" aria-labelledby="t-test">
    <div class="test-cta">
      <div>
        <h2 id="t-test">{tx.recomendar.cta}</h2>
        <p>{tx.recomendar.ctaTexto}</p>
      </div>
      <a href="/recomendaciones/" class="pastilla boton-test">{tx.recomendar.ctaBoton} →</a>
    </div>
  </section>

  {
    guiasPortada.length > 0 && (
      <section class="contenedor guias-portada" aria-labelledby="t-guias">
        <h2 id="t-guias">{tx.portada.guias}</h2>
        <p class="sub">{tx.portada.guiasTexto}</p>
        <ul>
          {guiasPortada.map(({ u, g }) => (
            <li style={estiloUniverso(u)}>
              <a href={`/${u.id}/guias/${g.id}/`}>
                <span class="marca-u">{u.data.nombre}</span>
                <span class="nombre-guia">{g.titulo}</span>
                <span class="desc-guia">{g.descripcion}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    proximos.length > 0 && (
      <section class="contenedor proximos" data-bloque aria-labelledby="t-proximos">
        <div class="cabecera-proximos">
          <h2 id="t-proximos">{tx.proximos.titulo}</h2>
          <a href="/proximamente/" class="ver-todos">
            {tx.proximos.verTodos} →
          </a>
        </div>
        <ListaEstrenos>
          {proximos.map((e) => (
            <TarjetaEstreno e={e} u={activos.find((u) => u.id === e.universo)} />
          ))}
        </ListaEstrenos>
      </section>
    )
  }
</Base>

<style>
  .portada {
    padding-top: clamp(24px, 5vw, 48px);
  }
  .intro {
    font: 700 1rem var(--f-titulo);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--txt-2);
    margin-bottom: 16px;
  }
  .universos {
    display: grid;
    grid-template-columns: 2fr repeat(calc(var(--n) - 1), 1fr);
    gap: 18px;
  }
  .universo {
    position: relative;
    isolation: isolate;
    min-height: clamp(320px, 52vh, 520px);
    border-radius: calc(var(--radio) + 6px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: clamp(20px, 3vw, 32px);
    text-decoration: none;
    color: #fff;
    background: #101218;
    box-shadow: var(--sombra);
  }
  .universo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 25%, rgb(0 0 0 / 0.88));
  }
  .mosaico {
    position: absolute;
    inset: -10%;
    z-index: -2;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    transform: skewX(-8deg);
    opacity: 0.7;
    transition: transform 0.6s ease, opacity 0.3s;
  }
  .mosaico :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  .universo:hover .mosaico,
  .universo:focus-visible .mosaico {
    transform: skewX(-8deg) scale(1.04);
    opacity: 0.85;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nombre {
    font: 800 clamp(3rem, 8vw, 5.4rem) / 0.9 var(--f-titulo);
    text-transform: uppercase;
    align-self: flex-start;
    box-shadow: inset 0 -0.13em 0 var(--acento);
  }
  .secciones {
    color: #d9dde6;
    font-weight: 500;
  }
  .total {
    font-size: 0.9rem;
    color: #b9bfcc;
  }
  .pronto {
    background: radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--acento) 55%, #000), #05070c 75%);
  }
  .pronto .nombre {
    font-size: clamp(2.6rem, 6vw, 4rem);
  }
  .etiqueta-pronto {
    align-self: flex-start;
    margin-top: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
  }
  .proximos {
    margin-top: clamp(32px, 5vw, 56px);
  }
  /* Guías para empezar */
  .guias-portada {
    margin-top: clamp(32px, 5vw, 56px);
  }
  .guias-portada h2 {
    margin: 0 0 4px;
  }
  .guias-portada .sub {
    margin: 0 0 16px;
    color: var(--txt-2);
    max-width: 70ch;
  }
  .guias-portada ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 12px;
  }
  .guias-portada a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--borde);
    border-top: 4px solid var(--acento);
    border-radius: var(--radio);
    background: var(--sup);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transicion), transform var(--transicion);
  }
  .guias-portada a:hover,
  .guias-portada a:focus-visible {
    border-color: var(--acento);
    transform: translateY(-2px);
  }
  .marca-u {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--acento-txt);
  }
  .nombre-guia {
    font: 700 1.1rem / 1.2 var(--f-titulo);
  }
  .desc-guia {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.88rem;
    color: var(--txt-2);
  }
  /* Llamada al test «¿Qué veo?» */
  .test-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    margin-top: clamp(24px, 4vw, 40px);
    padding-block: clamp(18px, 3vw, 26px);
    border-block: 1px solid var(--borde);
  }
  .test-cta h2 {
    margin: 0 0 4px;
  }
  .test-cta p {
    margin: 0;
    max-width: 62ch;
    color: var(--txt-2);
  }
  .boton-test {
    background: var(--txt);
    color: var(--fondo);
    border-color: var(--txt);
    padding: 12px 20px;
  }
  .cabecera-proximos {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: 16px;
  }
  .cabecera-proximos h2 {
    margin: 0;
  }
  .ver-todos {
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .universos {
      grid-template-columns: 1fr;
    }
    .universo.pronto {
      min-height: 180px;
    }
  }
</style>
