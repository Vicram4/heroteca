---
import { conIdiomas } from '../../../i18n';
/**
 * Inicio de un universo: sus estanterías, como tu presentación «999 estanterias».
 * Cada sección muestra su primera balda y enlaza a la estantería completa.
 */
import Base from '../../../layouts/Base.astro';
import SubNav from '../../../components/SubNav.astro';
import Caja from '../../../components/Caja.astro';
import { universosActivos, titulosDe, huecosDeSeccion, sagasDe } from '../../../lib/datos';
import { guiasDe, guiaLoc } from '../../../config/guias';
import { textos, idiomaDe } from '../../../i18n';
import { universoLoc, sagaLoc } from '../../../i18n/datos';
import ListaNoticias from '../../../components/ListaNoticias.astro';
import { noticiasDe } from '../../../lib/noticias';
const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);

export async function getStaticPaths() {
  return conIdiomas(await (async () => {
  return (await universosActivos()).map((universo) => ({ params: { universo: universo.id }, props: { universo } }));
})());
}
const universo = universoLoc(Astro.props.universo, idioma);
const titulos = await titulosDe(universo.id);
const secciones = universo.data.secciones.map((s) => {
  const huecos = huecosDeSeccion(titulos.filter((t) => t.d.seccion === s.id), s);
  return { s, huecos, total: huecos.filter((h) => !h.repetido).length, muestra: huecos.slice(0, 8) };
});
const relacionadas = (await sagasDe(universo.id))
  .filter((s) => !s.data.padre && ['multiverso', 'saga'].includes(s.data.tipo) && s.data.orden < 100)
  .map((s) => sagaLoc(s, idioma));
---

<Base
  titulo={universo.data.tituloSeo ?? universo.data.nombre}
  descripcion={universo.data.descripcion}
  universo={universo}
  migas={[{ nombre: 'Heroteca', url: '/' }, { nombre: universo.data.nombre, url: `/${universo.id}/` }]}
>
  <SubNav slot="subnav" universo={universo} activo="inicio" />
  <div class="contenedor">
    <header class="cab">
      <h1><span class="nombre">{universo.data.nombre}</span></h1>
      <p>{universo.data.descripcion} {tx.hub.resumen(titulos.length, secciones.length)}</p>
    </header>

    {
      guiasDe(universo.id).length > 0 && (
        <nav class="guias-rapidas" aria-label={tx.hub.guiasAria}>
          <span class="etiqueta">{tx.hub.guias}</span>
          {guiasDe(universo.id).map((g) => guiaLoc(g, idioma)).map((g) => (
            <a class="pastilla" href={`/${universo.id}/guias/${g.id}/`}>
              {g.titulo}
            </a>
          ))}
        </nav>
      )
    }

    {
      secciones.map(({ s, huecos, total, muestra }) => (
        <section class="seccion" aria-labelledby={`sec-${s.id}`}>
          <div class="cab-seccion">
            <h2 id={`sec-${s.id}`}>
              <a href={`/${universo.id}/${s.id}/`}>{s.nombre}</a>
            </h2>
            <p>{s.descripcion}</p>
            <a class="pastilla ver" href={`/${universo.id}/${s.id}/`}>
              {tx.hub.verLos(total)} <span aria-hidden="true">→</span>
            </a>
          </div>
          <ol class="balda-muestra estanteria" data-orden="historia" style="--hueco-x: clamp(14px, 2.4vw, 26px)">
            {muestra.map((h, i) => (
              <Caja hueco={h} prioridad={i < 6 && s === secciones[0].s} />
            ))}
          </ol>
          {huecos.length > muestra.length && <p class="mas">{tx.hub.mas(total - muestra.length)}</p>}
        </section>
      ))
    }

    {
      relacionadas.length > 0 && (
        <section class="seccion" aria-labelledby="sec-relacionadas">
          <div class="cab-seccion">
            <h2 id="sec-relacionadas">
              <a href={`/${universo.id}/sagas/`}>{tx.hub.relacionadas}</a>
            </h2>
            <a class="pastilla ver" href={`/${universo.id}/sagas/`}>
              {tx.hub.todasSagas} <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="relacionadas">
            {relacionadas.map((s) => (
              <li>
                <a class="chip" href={`/${universo.id}/sagas/${s.id}/`}>
                  {s.data.nombre}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      noticiasDe(idioma, universo.id).length > 0 && (
        <section class="seccion" aria-labelledby="sec-noticias">
          <div class="cab-noticias">
            <h2 id="sec-noticias">{tx.noticias.ultimasDe(universo.data.nombre)}</h2>
            <a href={`/${universo.id}/noticias/`}>{tx.noticias.verTodas} →</a>
          </div>
          <ListaNoticias noticias={noticiasDe(idioma, universo.id, 4)} universos={[Astro.props.universo]} compacta />
        </section>
      )
    }
  </div>
</Base>

<style>
  .cab-noticias {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
    margin-bottom: 12px;
  }
  .cab-noticias h2 {
    margin: 0;
  }
  .cab-noticias a {
    font-weight: 600;
  }
  .cab {
    padding: clamp(24px, 4vw, 40px) 0 8px;
  }
  .cab .nombre {
    box-shadow: inset 0 -0.13em 0 var(--acento);
    text-transform: uppercase;
  }
  .cab p {
    color: var(--txt-2);
    margin-top: 12px;
  }
  .seccion {
    margin-top: clamp(28px, 5vw, 48px);
  }
  .cab-seccion {
    display: flex;
    align-items: baseline;
    gap: 6px 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .cab-seccion h2 a {
    text-decoration: none;
  }
  .cab-seccion h2 a:hover {
    color: var(--acento-txt);
  }
  .cab-seccion p {
    margin: 0;
    color: var(--txt-2);
  }
  .ver {
    margin-left: auto;
  }
  .balda-muestra {
    list-style: none;
    margin: 0;
    padding: 0 calc(var(--hueco-x) / 2);
    display: grid;
    grid-template-columns: repeat(8, minmax(118px, 1fr));
    column-gap: var(--hueco-x);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .balda-muestra :global(.celda) {
    scroll-snap-align: start;
  }
  .mas {
    color: var(--txt-2);
    font-size: 0.9rem;
    margin-top: 10px;
  }
  .relacionadas {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .relacionadas .chip {
    font-size: 0.95rem;
    padding: 9px 14px;
  }
  .guias-rapidas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: -4px 0 12px;
  }
  .guias-rapidas .etiqueta {
    font: 700 0.95rem var(--f-titulo);
    color: var(--txt-2);
    margin-right: 4px;
  }
  .guias-rapidas .pastilla {
    text-decoration: none;
  }
</style>
