---
import { tablasEn } from '../../../../i18n/rutas';
import { conIdiomas } from '../../../../i18n';
/** Una guía de visionado: listas en orden generadas a partir de las fichas. */
import Base from '../../../../layouts/Base.astro';
import BotonVolver from '../../../../components/BotonVolver.astro';
import SubNav from '../../../../components/SubNav.astro';
import ListaOrden from '../../../../components/ListaOrden.astro';
import ComparaOrden from '../../../../components/ComparaOrden.astro';
import Caratula from '../../../../components/Caratula.astro';
import Progreso from '../../../../components/Progreso.astro';
import { datosTmdb } from '../../../../lib/tmdb';
import { leerEpoca, NOTAS } from '../../../../lib/lineaTemporal';
import { SITE } from '../../../../config/site';
import { GUIAS, guiaLoc, type Guia } from '../../../../config/guias';
import {
  universosActivos,
  titulosDe,
  sagasDe,
  huecosDeSeccion,
  huecosPorCarpetas,
  visionadosDe,
  urlCarpeta,
  numeroTexto,
  textoTramo,
  type Titulo,
  type Universo,
} from '../../../../lib/datos';
import { textos, idiomaDe, LOCALE, nombreTipo } from '../../../../i18n';
import { rutaEnIdioma } from '../../../../i18n/rutas';
import { universoLoc, sagaLoc } from '../../../../i18n/datos';

export async function getStaticPaths() {
  const en = await tablasEn();
  return conIdiomas(await (async () => {
  const activos = new Set((await universosActivos()).map((u) => u.id));
  const universos = await universosActivos();
  return GUIAS.filter((g) => activos.has(g.universo)).map((guia) => ({
    params: { universo: guia.universo, guias: 'guias', guia: guia.id },
    props: { guia, universo: universos.find((u) => u.id === guia.universo)! },
  }));
})(), (r) => ({ guias: 'guides', guia: en.guias.get(r.params.guia) }));
}

const guia = guiaLoc((Astro.props as { guia: Guia }).guia, idiomaDe(Astro.url));
const universo = universoLoc((Astro.props as { universo: Universo }).universo, idiomaDe(Astro.url));
const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);
const titulos = await titulosDe(universo.id, idioma);
const sagas = (await sagasDe(universo.id)).map((s) => sagaLoc(s, idioma));
const fases = sagas.filter((s) => s.data.tipo === 'fase');
const faseDe = (t: Titulo) => fases.find((f) => t.d.sagas.some((r) => r.id === f.id))?.data.nombre;
const fechaCorta = (t: Titulo) =>
  t.m.fecha ? t.m.fecha.toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : undefined;

type Fila = { num?: string; t: Titulo; detalle?: string; fase?: string };
type Bloque = { id: string; titulo: string; texto?: string; filas: Fila[]; enlace?: { texto: string; url: string }; cabeceraNum?: string };
const bloques: Bloque[] = [];
// Cronológico frente a estreno (secciones con orden de la historia)
type Comparacion = { id: string; titulo: string; seccion: string; filas: { t: Titulo; historia: number; estreno: number }[] };
const comparaciones: Comparacion[] = [];
// Preguntas frecuentes de las secciones con orden de la historia (respuestas calculadas con los datos)
type Pregunta = { pregunta: string; respuesta: (string | { texto: string; url: string })[] };
const preguntas: Pregunta[] = [];
const minutosDe = (t: Titulo) => {
  const dt = datosTmdb(t.universo, t.id, 'es');
  const caps = dt?.capitulos ?? [];
  return caps.length ? caps.reduce((n, c) => n + (c.duracion ?? dt?.duracion ?? 0), 0) : (dt?.duracion ?? t.m.duracion ?? 0);
};

// Carpetas de visionado (series)
type BloqueCarpeta = {
  id: string;
  numero: number;
  etapa: string;
  filas: Fila[];
  orden?: { n?: number; t?: Titulo; codigo?: string; capitulo?: string; mega: boolean; nota?: string }[];
  borrador: boolean;
};
const carpetas: BloqueCarpeta[] = [];

for (const id of guia.secciones) {
  const seccion = universo.data.secciones.find((s) => s.id === id);
  // La línea temporal usa las secciones a su manera (más abajo)
  if (!seccion || guia.tipo === 'linea') continue;
  const deSeccion = titulos.filter((t) => t.d.seccion === id);
  if (guia.tipo === 'carpetas') {
    const visionados = await visionadosDe(universo.id);
    const { huecos } = huecosPorCarpetas(deSeccion, seccion);
    const porId = new Map(titulos.map((t) => [t.id, t]));
    for (const n of guia.carpetas ?? []) {
      const def = seccion.carpetas.find((c) => c.numero === n);
      const v = visionados.find((x) => x.data.carpeta === n && x.data.seccion === id);
      carpetas.push({
        id: `carpeta-${n}`,
        numero: n,
        etapa: def?.etapa ?? '',
        filas: huecos.filter((h) => h.carpeta === n).map((h) => ({ num: h.codigo, t: h.titulo })),
        orden: v?.data.orden.map((o) => ({
          n: o.n,
          t: porId.get(o.titulo.id),
          codigo: o.codigo,
          capitulo:
            idioma === 'en' && o.codigo
              ? porId.get(o.titulo.id)?.m.capitulos.find((c) => c.codigo === o.codigo)?.titulo || o.capitulo
              : o.capitulo,
          mega: o.megacrossover,
          nota: o.nota,
        })),
        borrador: v?.data.borrador ?? false,
      });
    }
    continue;
  }
  const huecos = huecosDeSeccion(deSeccion, seccion);
  const conTramo = (h: (typeof huecos)[number]) => (h.tramo ? tx.guias.capitulosTramo(textoTramo(h)) : undefined);
  if (seccion.orden === 'cronologico') {
    bloques.push({
      id: `${id}-historia`,
      titulo: tx.guias.ordenCrono(seccion.nombre),
      texto: tx.guias.ordenCronoTexto,
      filas: huecos.map((h) => ({ num: numeroTexto(h.numero), t: h.titulo, detalle: conTramo(h), fase: faseDe(h.titulo) })),
      enlace: { texto: tx.guias.verEstanteria(seccion.nombre), url: `/${universo.id}/${id}/` },
    });
    const estreno = huecos.filter((h) => !h.repetido).sort((a, b) => a.ordenEstreno - b.ordenEstreno);
    bloques.push({
      id: `${id}-estreno`,
      titulo: tx.guias.ordenEstreno(seccion.nombre),
      texto: tx.guias.ordenEstrenoTexto,
      cabeceraNum: '#',
      filas: estreno.map((h, i) => ({ num: String(i + 1), t: h.titulo, detalle: fechaCorta(h.titulo), fase: faseDe(h.titulo) })),
    });
    // Puesto de cada título (sin repetir los tramos) en los dos órdenes
    const enHistoria: Titulo[] = [];
    for (const h of huecos) if (!enHistoria.includes(h.titulo)) enHistoria.push(h.titulo);
    const enEstreno = estreno.map((h) => h.titulo);
    comparaciones.push({
      id: `${id}-compara`,
      titulo: tx.guias.compara(seccion.nombre),
      seccion: seccion.nombre,
      filas: enHistoria.map((t, i) => ({ t, historia: i + 1, estreno: enEstreno.indexOf(t) + 1 })).filter((f) => f.estreno > 0),
    });
    // Preguntas frecuentes
    const fq = tx.guias.faq;
    const porTipo = new Map<string, number>();
    for (const t of enHistoria) porTipo.set(t.tipo, (porTipo.get(t.tipo) ?? 0) + 1);
    const lista = new Intl.ListFormat(LOCALE[idioma], { type: 'conjunction' });
    const partes = lista.format([...porTipo].sort((a, b) => b[1] - a[1]).map(([tipo, n]) => `${n} ${nombreTipo(tipo as Titulo['tipo'], idioma, n !== 1).toLowerCase()}`));
    preguntas.push({ pregunta: fq.cuantos(seccion.nombre), respuesta: [fq.cuantosR(seccion.nombre, enHistoria.length, partes)] });
    const primera = enHistoria[0];
    const primeraEstreno = enEstreno[0];
    if (primera) {
      const [antes, despues] = fq.primeraR('§', leerEpoca(primera.d.epoca)?.texto ?? '').split('§');
      const respuesta: Pregunta['respuesta'] = [antes, { texto: primera.corto, url: primera.url }, despues];
      if (primeraEstreno && primeraEstreno !== primera) {
        const [a2, d2] = fq.primeraEstreno('§', primeraEstreno.d.anio).split('§');
        respuesta.push(a2, { texto: primeraEstreno.corto, url: primeraEstreno.url }, d2);
      }
      preguntas.push({ pregunta: fq.primera(seccion.nombre), respuesta });
    }
    const reciente = enEstreno.at(-1);
    if (reciente) {
      const [a3, d3] = fq.recienteR('§', reciente.d.anio).split('§');
      preguntas.push({ pregunta: fq.reciente(seccion.nombre), respuesta: [a3, { texto: reciente.corto, url: reciente.url }, d3] });
    }
    const horas = Math.round(enHistoria.reduce((n, t) => n + minutosDe(t), 0) / 60);
    if (horas) preguntas.push({ pregunta: fq.horas(seccion.nombre), respuesta: [fq.horasR(horas, Math.round(horas / 24))] });
    const empezar = GUIAS.find((g) => g.universo === universo.id && g.tipo === 'rutas');
    if (empezar) {
      const g = guiaLoc(empezar, idioma);
      preguntas.push({ pregunta: fq.empezar, respuesta: [`${fq.empezarR} `, { texto: g.titulo, url: `/${universo.id}/guias/${g.id}/` }, '.'] });
    }
  } else {
    bloques.push({
      id,
      titulo: seccion.nombre,
      texto: seccion.descripcion,
      filas: huecos.map((h) => ({ num: h.numero !== undefined ? numeroTexto(h.numero) : '—', t: h.titulo, detalle: conTramo(h) })),
      enlace: { texto: tx.guias.verEstanteria(seccion.nombre), url: `/${universo.id}/${id}/` },
    });
  }
}

// «Por dónde empezar»: rutas de títulos elegidos a mano (un id mal escrito para la compilación)
const porIdTitulo = new Map(titulos.map((t) => [t.id, t]));
const rutas = (guia.rutas ?? []).map((r, i) => ({
  id: `ruta-${i + 1}`,
  titulo: r.titulo,
  texto: r.texto,
  titulos: r.ids.map((id) => {
    const t = porIdTitulo.get(id);
    if (!t) throw new Error(`Guía «${guia.id}»: no existe la ficha «${id}» en ${universo.id}`);
    return t;
  }),
}));
const duracion = (t: Titulo) => {
  const min = t.m.duracion;
  if (t.tipo === 'serie' && t.m.capitulos.length) return tx.recomendar.capitulos(t.m.capitulos.length);
  return min ? tx.recomendar.horas(Math.floor(min / 60), min % 60) : undefined;
};
const notaDe = (t: Titulo) => {
  const d = datosTmdb(t.universo, t.id, 'es');
  return d?.nota && (d.votos ?? 0) >= 20 ? d.nota.toLocaleString(LOCALE[idioma], { minimumFractionDigits: 1 }) : undefined;
};

// Línea temporal (tipo 'linea'): títulos agrupados por el año en que empiezan, en el orden de la colección
const linea: { anio: number; titulos: { t: Titulo; texto: string; varios: boolean }[] }[] = [];
const sinFecha: Titulo[] = [];
if (guia.tipo === 'linea') {
  for (const id of guia.secciones) {
    const seccion = universo.data.secciones.find((s) => s.id === id);
    if (!seccion) continue;
    const enOrden: Titulo[] = [];
    for (const h of huecosDeSeccion(titulos.filter((t) => t.d.seccion === id), seccion)) if (!enOrden.includes(h.titulo)) enOrden.push(h.titulo);
    const conEpoca = enOrden.map((t, i) => ({ t, i, e: leerEpoca(t.d.epoca) }));
    for (const x of conEpoca.filter((x) => !x.e)) sinFecha.push(x.t);
    for (const x of conEpoca.filter((x) => x.e).sort((a, b) => a.e!.desde - b.e!.desde || a.i - b.i)) {
      const g = linea.at(-1)?.anio === x.e!.desde ? linea.at(-1)! : (linea.push({ anio: x.e!.desde, titulos: [] }), linea.at(-1)!);
      g.titulos.push({ t: x.t, texto: x.e!.texto, varios: x.e!.hasta > x.e!.desde });
    }
  }
}

// Datos estructurados: la primera lista como ItemList
const primera = linea.length ? linea.flatMap((g) => g.titulos.map(({ t }) => ({ t }))) : bloques[0]?.filas ?? (rutas.length ? rutas[0].titulos.map((t) => ({ t })) : carpetas.flatMap((c) => c.filas));
const urlsLista = await Promise.all(primera.map((f) => rutaEnIdioma(f.t.url, idioma)));
const datos = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: guia.titulo,
  description: guia.descripcion,
  numberOfItems: primera.length,
  itemListElement: primera.map((f, i) => ({ '@type': 'ListItem', position: i + 1, name: f.t.corto, url: new URL(urlsLista[i], SITE.url).href })),
};
const indice = [...rutas.map((r) => ({ id: r.id, texto: r.titulo })), ...bloques.map((b) => ({ id: b.id, texto: b.titulo })), ...comparaciones.map((c) => ({ id: c.id, texto: c.titulo })), ...(preguntas.length ? [{ id: 'preguntas', texto: tx.guias.faq.titulo }] : []), ...carpetas.map((c) => ({ id: c.id, texto: `${tx.general.carpeta(c.numero)} · ${c.etapa}` }))];
const colores = (c: BloqueCarpeta) => [...new Set((c.orden ?? []).map((o) => o.t?.id))];
---

<Base
  titulo={guia.tituloSeo}
  descripcion={guia.descripcion}
  universo={universo}
  datos={datos}
  migas={[
    { nombre: 'Heroteca', url: '/' },
    { nombre: universo.data.nombre, url: `/${universo.id}/` },
    { nombre: tx.guias.titulo, url: `/${universo.id}/guias/` },
    { nombre: guia.titulo, url: `/${universo.id}/guias/${guia.id}/` },
  ]}
>
  <SubNav slot="subnav" universo={universo} activo="guias" />
  <article class="contenedor guia">
    <header class="cab">
      <BotonVolver href={`/${universo.id}/guias/`} conEspacio={false}>
        <nav class="miga" aria-label={tx.general.estasEn}>
          <a href={`/${universo.id}/guias/`}>{tx.guias.titulo}</a>
        </nav>
      </BotonVolver>
      <h1>{guia.titulo}</h1>
      {guia.intro.map((p) => <p class="intro">{p}</p>)}
    </header>

    {
      indice.length > 1 && (
        <nav class="indice panel" aria-label={tx.guias.enEsta}>
          <strong>{tx.guias.enEsta}</strong>
          <ol>
            {indice.map((i) => (
              <li>
                <a href={`#${i.id}`}>{i.texto}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      bloques.map((b) => (
        <section id={b.id} class="bloque" aria-labelledby={`h-${b.id}`}>
          <h2 id={`h-${b.id}`}>{b.titulo}</h2>
          {b.texto && <p class="texto">{b.texto}</p>}
          <ListaOrden filas={b.filas} conFases={guia.conFases} cabeceraNum={b.cabeceraNum} etiqueta={b.titulo} />
          {b.enlace && (
            <p class="enlace">
              <a href={b.enlace.url}>{b.enlace.texto} →</a>
            </p>
          )}
        </section>
      ))
    }

    {
      linea.length > 0 && (
        <section class="linea" aria-label={guia.titulo}>
          <nav class="saltos" aria-label={tx.guias.linea.ir}>
            <span>{tx.guias.linea.ir}:</span>
            {linea.map((g) => (
              <a href={`#a-${g.anio}`} class="chip">
                {g.anio}
              </a>
            ))}
          </nav>
          <ol class="anios">
            {linea.map((g) => (
              <li class="anio" id={`a-${g.anio}`}>
                <h2 class="marca-anio">{g.anio}</h2>
                <ul class="titulos-anio">
                  {g.titulos.map(({ t, texto, varios }) => (
                    <li class={`t-${t.tipo}`} data-titulo={t.id}>
                      <a href={t.url}>
                        <span class="tapa">{t.portada || t.m.posterTmdb ? <Caratula t={t} ancho={56} /> : null}</span>
                        <span class="texto-t">
                          <span class="nombre">
                            {t.corto}
                            <span class="marca-visto">
                              <span aria-hidden="true">✓</span>
                              <span class="solo-lectores">{tx.progreso.visto}</span>
                            </span>
                          </span>
                          <span class="meta">
                            {[varios ? texto : '', t.d.animada ? tx.general.animado(nombreTipo(t.tipo, idioma)) : nombreTipo(t.tipo, idioma), t.d.anio && tx.guias.linea.estreno(t.d.anio)].filter(Boolean).join(' · ')}
                          </span>
                          {NOTAS[t.id] && <span class="nota">{NOTAS[t.id][idioma]}</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
          {sinFecha.length > 0 && (
            <section class="sin-fecha" aria-labelledby="h-sin-fecha">
              <h2 id="h-sin-fecha">{tx.guias.linea.sinFecha}</h2>
              <p class="texto">{tx.guias.linea.sinFechaTexto}</p>
              <ul>
                {sinFecha.map((t) => (
                  <li data-titulo={t.id}>
                    <a href={t.url}>{t.corto}</a>
                    <span class="marca-visto">
                      <span aria-hidden="true">✓</span>
                      <span class="solo-lectores">{tx.progreso.visto}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          <p class="fuente-linea">{tx.guias.linea.fuente}</p>
        </section>
      )
    }

    {
      rutas.map((r) => (
        <section id={r.id} class="bloque" aria-labelledby={`h-${r.id}`}>
          <h2 id={`h-${r.id}`}>{r.titulo}</h2>
          <p class="texto">{r.texto}</p>
          <Progreso ids={r.titulos.map((t) => t.id)} conEnlace />
          <ol class="ruta">
            {r.titulos.map((t, i) => (
              <li class={`t-${t.tipo}`} data-titulo={t.id}>
                <a href={t.url}>
                  <span class="tapa">
                    {t.portada || t.m.posterTmdb ? <Caratula t={t} ancho={120} /> : null}
                    <span class="paso" aria-hidden="true">{i + 1}</span>
                    <span class="marca-visto">
                      <span aria-hidden="true">✓</span>
                      <span class="solo-lectores">{tx.progreso.visto}</span>
                    </span>
                  </span>
                  <span class="nombre">{t.corto}</span>
                  <span class="meta">
                    {[t.d.anio, t.d.animada ? tx.general.animado(nombreTipo(t.tipo, idioma)) : nombreTipo(t.tipo, idioma), duracion(t)].filter(Boolean).join(' · ')}
                  </span>
                  {notaDe(t) && <span class="meta">★ {notaDe(t)}<span class="solo-lectores"> ({tx.recomendar.nota})</span></span>}
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      rutas.length > 0 && (
        <aside class="panel siguiente-paso">
          <div>
            <h2>{tx.recomendar.cta}</h2>
            <p>{tx.recomendar.ctaTexto}</p>
          </div>
          <a href="/recomendaciones/" class="pastilla boton-test">
            {tx.recomendar.ctaBoton} →
          </a>
        </aside>
      )
    }

    {
      comparaciones.map((c) => (
        <section id={c.id} class="bloque" aria-labelledby={`h-${c.id}`}>
          <h2 id={`h-${c.id}`}>{c.titulo}</h2>
          <p class="texto">{tx.guias.comparaTexto}</p>
          <ComparaOrden filas={c.filas} seccion={c.seccion} />
        </section>
      ))
    }

    {
      preguntas.length > 0 && (
        <section id="preguntas" class="bloque preguntas" aria-labelledby="h-preguntas">
          <h2 id="h-preguntas">{tx.guias.faq.titulo}</h2>
          {preguntas.map((q) => (
            <>
              <h3>{q.pregunta}</h3>
              <p>{q.respuesta.map((parte) => (typeof parte === 'string' ? parte : <a href={parte.url}>{parte.texto}</a>))}</p>
            </>
          ))}
        </section>
      )
    }

    {
      carpetas.map((c) => (
        <section id={c.id} class="bloque" aria-labelledby={`h-${c.id}`}>
          <h2 id={`h-${c.id}`}>
            {tx.general.carpeta(c.numero)} <span class="etapa">· {c.etapa}</span>
          </h2>
          <ListaOrden filas={c.filas} cabeceraNum={tx.guias.codigo} etiqueta={tx.carpetas.temporadasDe(c.numero)} />
          {c.orden && (
            <details class="capitulos" open>
              <summary>
                {tx.guias.pasos(c.orden.length)}{c.borrador && tx.guias.borrador}
              </summary>
              {c.borrador && <p class="texto">{tx.guias.borradorTexto}</p>}
              <ol class="pasos">
                {c.orden.map((o) => (
                  <li class:list={{ mega: o.mega }} style={`--c-serie: var(--serie-${colores(c).indexOf(o.t?.id) % 6})`}>
                    <span class="n">{o.n !== undefined ? String(o.n).padStart(2, '0') : '·'}</span>
                    <a href={o.t?.url}>{o.t?.d.titulo}</a>
                    <span class="cod">{o.codigo ?? (o.t?.d.temporada ? tx.carpetas.temporadaCorta(o.t.d.temporada) : '')}</span>
                    <span class="cap">
                      {o.capitulo ?? tx.carpetas.completa}
                      {o.mega && <span class="chip-mega">Megacrossover</span>}
                    </span>
                  </li>
                ))}
              </ol>
            </details>
          )}
          <p class="enlace">
