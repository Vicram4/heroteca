---
import { conIdiomas } from '../../../../i18n';
/** Guías de visionado de un universo. */
import Base from '../../../../layouts/Base.astro';
import SubNav from '../../../../components/SubNav.astro';
import { guiasDe } from '../../../../config/guias';
import { universosActivos } from '../../../../lib/datos';

export async function getStaticPaths() {
  return conIdiomas(await (async () => {
  return (await universosActivos())
    .filter((u) => guiasDe(u.id).length > 0)
    .map((universo) => ({ params: { universo: universo.id }, props: { universo } }));
})());
}
import { textos } from '../../../../i18n';
const tx = textos(Astro.url);
const { universo } = Astro.props;
const guias = guiasDe(universo.id);
---

<Base
  titulo={tx.guias.tituloSeo(universo.data.nombre)}
  descripcion={tx.guias.descripcion(universo.data.nombre, guias.map((g) => g.titulo.toLowerCase()).join(', '))}
  universo={universo}
  migas={[{ nombre: 'Heroteca', url: '/' }, { nombre: universo.data.nombre, url: `/${universo.id}/` }, { nombre: tx.guias.titulo, url: `/${universo.id}/guias/` }]}
>
  <SubNav slot="subnav" universo={universo} activo="guias" />
  <div class="contenedor">
    <header class="cab">
      <h1>{tx.guias.de(universo.data.nombre)}</h1>
      <p>{tx.guias.intro(universo.data.nombre)}</p>
    </header>
    <ul class="guias">
      {
        guias.map((g) => (
          <li class="panel">
            <h2>
              <a href={`/${universo.id}/guias/${g.id}/`}>{g.titulo}</a>
            </h2>
            <p>{g.descripcion}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .cab {
    padding: clamp(22px, 4vw, 36px) 0 18px;
  }
  .cab p {
    color: var(--txt-2);
  }
  .guias {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }
  .guias h2 {
    margin: 0 0 6px;
    font-size: 1.35rem;
  }
  .guias h2 a {
    text-decoration: none;
  }
  .guias h2 a:hover {
    text-decoration: underline;
  }
  .guias p {
    margin: 0;
    color: var(--txt-2);
  }
</style>
