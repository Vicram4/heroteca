---
import Base from '../layouts/Base.astro';
import { textosDe } from '../i18n';
// Vercel sirve esta misma página para cualquier dirección que no existe, también en /en/: va en los dos idiomas
const tx = textosDe('es');
const en = textosDe('en');
import { universosActivos } from '../lib/datos';

const universos = await universosActivos();
---

<Base titulo={tx.error404.titulo} noIndexar>
  <section class="contenedor error">
    <p class="codigo" aria-hidden="true">404</p>
    <h1>{tx.error404.h1}</h1>
    <p>{tx.error404.texto}</p>
    <div class="acciones">
      {universos.map((u) => <a class="pastilla" href={`/${u.id}/`}>{tx.error404.irA(u.data.nombre)}</a>)}
      <a class="pastilla" href="/">{tx.error404.portada}</a>
    </div>
    <div class="en" lang="en">
      <h2>{en.error404.h1}</h2>
      <p>{en.error404.texto}</p>
      <div class="acciones">
        {universos.map((u) => <a class="pastilla" href={`/en/${u.id}/`}>{en.error404.irA(u.data.nombre)}</a>)}
        <a class="pastilla" href="/en/">{en.error404.portada}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .en {
    margin: 40px auto 0;
    padding-top: 28px;
    max-width: 560px;
    border-top: 1px solid var(--borde);
  }
  .en h2 {
    margin: 0 0 8px;
    font-size: 1.3rem;
  }
  .error {
    padding-block: clamp(48px, 10vw, 110px);
    text-align: center;
  }
  .codigo {
    font: 800 clamp(5rem, 18vw, 10rem) / 0.9 var(--f-titulo);
    color: var(--acento-txt);
    margin: 0;
  }
  .error > p {
    color: var(--txt-2);
    margin-top: 14px;
  }
  .acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
</style>
