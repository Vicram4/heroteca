---
/**
 * Estantería con filtros. El orden (historia / estreno) y los filtros se aplican en el navegador
 * sin recargar: las cajas se reordenan con CSS y se ocultan las que no encajan.
 */
import Caja from './Caja.astro';
import { textos, idiomaDe, nombreTipo } from '../i18n';
import { sagaLoc, personajeLoc } from '../i18n/datos';
import type { CabeceraCarpeta, Hueco, Saga } from '../lib/datos';
import { apariciones } from '../lib/personajes';
import { clavePlataforma, plataformasIncluidas, paisDe } from '../lib/dondever';

interface Props {
  huecos: Hueco[];
  /** Si la sección tiene orden de la historia, se ofrece alternar con el de estreno */
  cronologica: boolean;
  sagas?: Saga[];
  etiqueta: string;
  /** Secciones por carpetas: una cabecera por carpeta (solo se ve en orden de la historia) */
  cabeceras?: CabeceraCarpeta[];
  /** Texto del botón del orden propio («Orden de la historia», «Por carpetas»…) */
  nombreOrden?: string;
  /** Qué significa el número de cada caja en esta estantería (se muestra en la leyenda) */
  explicacionNumero?: string;
}
const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);
const { huecos, cronologica, sagas = [], etiqueta, cabeceras = [], nombreOrden = tx.estanteria.historia, explicacionNumero = tx.estanteria.numGenerico } = Astro.props;
const tipos = [...new Set(huecos.map((h) => h.titulo.tipo))];
const hayAnimadas = huecos.some((h) => h.titulo.d.animada) && huecos.some((h) => !h.titulo.d.animada);
const decadas = [...new Set(huecos.map((h) => Math.floor(h.titulo.d.anio / 10) * 10))].sort();
const idsSagas = new Set(huecos.flatMap((h) => h.titulo.d.sagas.map((s) => s.id)));
const sagasPresentes = sagas.filter((s) => idsSagas.has(s.id)).map((s) => sagaLoc(s, idioma));
const total = huecos.filter((h) => !h.repetido).length;
const { porTitulo, personajes } = await apariciones();
const cuenta = new Map<string, number>();
for (const t of new Set(huecos.map((h) => h.titulo.id))) for (const p of porTitulo.get(t) ?? []) cuenta.set(p, (cuenta.get(p) ?? 0) + 1);
// Plataformas en las que se puede ver algo de esta estantería (suscripción o gratis), de más a menos títulos
const porPlataforma = new Map<string, Set<string>>();
for (const h of huecos) for (const p of plataformasIncluidas(h.titulo.id, paisDe(idioma))) (porPlataforma.get(p) ?? porPlataforma.set(p, new Set()).get(p)!).add(h.titulo.id);
const plataformas = [...porPlataforma].sort((a, b) => b[1].size - a[1].size || a[0].localeCompare(b[0], 'es'));
const personajesPresentes = personajes
  .filter((p) => (cuenta.get(p.id) ?? 0) > 1)
  .map((p) => personajeLoc(p, idioma))
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));
---

<section class="estanteria" data-estanteria data-orden={cronologica ? 'historia' : 'estreno'} data-vista="estanteria" aria-label={etiqueta}>
  <div class="herramientas">
    <div class="grupo" role="group" aria-label={tx.estanteria.vista}>
      <button type="button" class="pastilla" data-poner-vista="estanteria" aria-pressed="true">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1" /><rect x="9" y="1" width="6" height="6" rx="1" /><rect x="1" y="9" width="6" height="6" rx="1" /><rect x="9" y="9" width="6" height="6" rx="1" /></svg>
        {tx.estanteria.vistaEstanteria}
      </button>
      <button type="button" class="pastilla" data-poner-vista="lista" aria-pressed="false">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"><rect x="1" y="2" width="14" height="2.5" rx="1" /><rect x="1" y="6.75" width="14" height="2.5" rx="1" /><rect x="1" y="11.5" width="14" height="2.5" rx="1" /></svg>
        {tx.estanteria.vistaLista}
      </button>
    </div>
    {
      cronologica && (
        <div class="grupo" role="group" aria-label={tx.estanteria.orden}>
          <button type="button" class="pastilla" data-poner-orden="historia" aria-pressed="true">{nombreOrden}</button>
          <button type="button" class="pastilla" data-poner-orden="estreno" aria-pressed="false">{tx.estanteria.estreno}</button>
        </div>
      )
    }
    {
      tipos.length > 1 && (
        <div class="grupo" role="group" aria-label={tx.estanteria.tipo}>
          <button type="button" class="pastilla" data-filtro-tipo="" aria-pressed="true">{tx.estanteria.todo}</button>
          {tipos.map((t) => (
            <button type="button" class:list={['pastilla', `t-${t}`]} data-filtro-tipo={t} aria-pressed="false">
              <i class="punto" aria-hidden="true" />
              {nombreTipo(t, idioma, true)}
            </button>
          ))}
        </div>
      )
    }
    {/* En móvil, los desplegables se agrupan tras este botón para no ocupar toda la pantalla */}
    <button type="button" class="pastilla boton-filtros" data-boton-filtros aria-expanded="false">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"><path d="M1 3h14l-5.5 6.2V14l-3-1.5V9.2Z" /></svg>
      {tx.estanteria.filtros}
      <span class="activos" data-activos hidden></span>
    </button>
    <div class="grupo selects">
      {
        hayAnimadas && (
          <label>
            <span class="solo-lectores">{tx.estanteria.animacion}</span>
            <select data-filtro-animada>
              <option value="">{tx.estanteria.realYAnimacion}</option>
              <option value="false">{tx.estanteria.soloReal}</option>
              <option value="true">{tx.estanteria.soloAnimacion}</option>
            </select>
          </label>
        )
      }
      {
        decadas.length > 1 && (
          <label>
            <span class="solo-lectores">{tx.estanteria.decada}</span>
            <select data-filtro-decada>
              <option value="">{tx.estanteria.todasDecadas}</option>
              {decadas.map((d) => (
                <option value={d}>{tx.estanteria.anios(d)}</option>
              ))}
            </select>
          </label>
        )
      }
      {
        personajesPresentes.length > 0 && (
          <label>
            <span class="solo-lectores">{tx.estanteria.personaje}</span>
            <select data-filtro-personaje>
              <option value="">{tx.estanteria.todosPersonajes}</option>
              {personajesPresentes.map((p) => (
                <option value={p.id}>{p.data.nombre} ({cuenta.get(p.id)})</option>
              ))}
            </select>
          </label>
        )
      }
      {
        plataformas.length > 0 && (
          <label>
            <span class="solo-lectores">{tx.estanteria.plataforma}</span>
            <select data-filtro-plataforma>
              <option value="">{tx.estanteria.todasPlataformas}</option>
              {plataformas.map(([nombre, ids]) => (
                <option value={clavePlataforma(nombre)}>
                  {tx.estanteria.enPlataforma(nombre, ids.size)}
                </option>
              ))}
            </select>
          </label>
        )
      }
      {
        sagasPresentes.length > 0 && (
          <label>
            <span class="solo-lectores">{tx.estanteria.saga}</span>
            <select data-filtro-saga>
              <option value="">{tx.estanteria.todasSagas}</option>
              {sagasPresentes.map((s) => (
                <option value={s.id}>{s.data.nombre}</option>
              ))}
            </select>
          </label>
        )
      }
    </div>
    <p class="cuenta" aria-live="polite" data-cuenta data-singular={tx.estanteria.titulo} data-plural={tx.estanteria.titulosPl}>{tx.general.titulos(total)}</p>
  </div>

  <p class="leyenda">
    <span class="marco">
      {tx.estanteria.marco}
      {tipos.map((t) => (
        <span class:list={['muestra', `t-${t}`]}>
          <i class="punto" aria-hidden="true" />
          {nombreTipo(t, idioma)}
        </span>
      ))}
    </span>
    <span class="que-numero">{explicacionNumero}</span>
  </p>

  <ol class="estante">
    {
      cabeceras.map((c) => (
        <li class="cabecera" style={`--o-h:${c.ordenHistoria}`} data-cabecera={c.carpeta}>
          <h2>
            {c.etapa === 'En espera' ? (
              tx.general.enEspera
            ) : (
              <>
                {tx.general.carpeta(c.carpeta)}
                {c.etapa && <span class="etapa"> · {c.etapa}</span>}
              </>
            )}
          </h2>
          {c.descripcion && <p>{c.descripcion}</p>}
          {c.visionado && (
            <a href={c.visionado} class="ver-orden">
              {tx.estanteria.verOrden}
            </a>
          )}
        </li>
      ))
    }
    {huecos.map((h, i) => <Caja hueco={h} prioridad={i < 6} personajes={[...(porTitulo.get(h.titulo.id) ?? [])]} />)}
  </ol>
  <p class="vacio" data-vacio hidden>{tx.estanteria.vacio}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-estanteria]').forEach((est) => {
    const celdas = [...est.querySelectorAll<HTMLLIElement>('.celda')];
    const cabeceras = [...est.querySelectorAll<HTMLLIElement>('[data-cabecera]')];
    const cuenta = est.querySelector<HTMLElement>('[data-cuenta]')!;
    const vacio = est.querySelector<HTMLElement>('[data-vacio]')!;
    const filtros = { tipo: '', animada: '', decada: '', saga: '', personaje: '', plataforma: '' };
    // Recuerda orden y filtros durante la sesión: al volver desde una ficha, la estantería sigue como estaba
    const clave = `estanteria:${location.pathname}:${est.getAttribute('aria-label') ?? ''}`;
    const guardar = () => {
      try {
        sessionStorage.setItem(clave, JSON.stringify({ orden: est.dataset.orden, filtros }));
      } catch {}
    };

    function aplicar() {
      const estreno = est.dataset.orden === 'estreno';
      const visibles = new Set<string>();
      for (const c of celdas) {
        const ok =
          !(estreno && c.dataset.repetido) &&
          (!filtros.tipo || c.dataset.tipo === filtros.tipo) &&
          (!filtros.animada || c.dataset.animada === filtros.animada) &&
          (!filtros.decada || c.dataset.decada === filtros.decada) &&
          (!filtros.saga || (c.dataset.sagas ?? '').split(' ').includes(filtros.saga)) &&
          (!filtros.personaje || (c.dataset.personajes ?? '').split(' ').includes(filtros.personaje)) &&
          (!filtros.plataforma || (c.dataset.plataformas ?? '').split(' ').includes(filtros.plataforma));
        c.hidden = !ok;
        if (ok) visibles.add(c.dataset.titulo ?? '');
      }
      // Una carpeta sin cajas visibles oculta también su cabecera
      for (const cab of cabeceras) cab.hidden = !celdas.some((c) => !c.hidden && c.dataset.carpeta === cab.dataset.cabecera);
      cuenta.textContent = `${visibles.size} ${visibles.size === 1 ? cuenta.dataset.singular : cuenta.dataset.plural}`;
      vacio.hidden = visibles.size > 0;
      guardar();
      // Número de desplegables con algún filtro puesto (se ve en el botón «Filtros» del móvil)
      const activos = ['animada', 'decada', 'saga', 'personaje', 'plataforma'].filter((k) => filtros[k as keyof typeof filtros]).length;
      const marcador = est.querySelector<HTMLElement>('[data-activos]');
      if (marcador) {
        marcador.textContent = String(activos);
        marcador.hidden = activos === 0;
      }
    }

    const pulsar = (grupo: string, boton: HTMLButtonElement) =>
      est.querySelectorAll(`[${grupo}]`).forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

    const botonFiltros = est.querySelector<HTMLButtonElement>('[data-boton-filtros]');
    botonFiltros?.addEventListener('click', () => {
      const abierto = botonFiltros.getAttribute('aria-expanded') !== 'true';
      botonFiltros.setAttribute('aria-expanded', String(abierto));
      est.toggleAttribute('data-filtros-abiertos', abierto);
    });

    // Vista estantería / lista: preferencia general, recordada en el navegador
    const ponerVista = (vista: string) => {
      const boton = est.querySelector<HTMLButtonElement>(`[data-poner-vista="${vista}"]`);
      if (!boton) return;
      est.dataset.vista = vista;
      pulsar('data-poner-vista', boton);
    };
    try {
      ponerVista(localStorage.getItem('vista-estanteria') ?? 'estanteria');
    } catch {}
    est.querySelectorAll<HTMLButtonElement>('[data-poner-vista]').forEach((b) =>
      b.addEventListener('click', () => {
        ponerVista(b.dataset.ponerVista ?? 'estanteria');
        try {
          localStorage.setItem('vista-estanteria', b.dataset.ponerVista ?? 'estanteria');
        } catch {}
      }),
    );

    est.querySelectorAll<HTMLButtonElement>('[data-poner-orden]').forEach((b) =>
      b.addEventListener('click', () => {
        est.dataset.orden = b.dataset.ponerOrden;
        pulsar('data-poner-orden', b);
        aplicar();
      }),
    );
    est.querySelectorAll<HTMLButtonElement>('[data-filtro-tipo]').forEach((b) =>
      b.addEventListener('click', () => {
        filtros.tipo = b.dataset.filtroTipo ?? '';
        pulsar('data-filtro-tipo', b);
        aplicar();
      }),
    );
    const desplegables = ['animada', 'decada', 'saga', 'personaje', 'plataforma'] as const;
    for (const c of desplegables) {
      est.querySelector<HTMLSelectElement>(`[data-filtro-${c}]`)?.addEventListener('change', (e) => {
        filtros[c] = (e.target as HTMLSelectElement).value;
        aplicar();
      });
    }

    // Restaurar lo guardado (solo valores que existen en esta estantería)
    try {
      const previo = JSON.parse(sessionStorage.getItem(clave) ?? 'null');
      if (previo) {
        const botonOrden = est.querySelector<HTMLButtonElement>(`[data-poner-orden="${previo.orden}"]`);
        if (botonOrden) {
          est.dataset.orden = previo.orden;
          pulsar('data-poner-orden', botonOrden);
        }
        const botonTipo = est.querySelector<HTMLButtonElement>(`[data-filtro-tipo="${previo.filtros?.tipo ?? ''}"]`);
        if (botonTipo) {
          filtros.tipo = previo.filtros.tipo;
          pulsar('data-filtro-tipo', botonTipo);
        }
        for (const c of desplegables) {
          const sel = est.querySelector<HTMLSelectElement>(`[data-filtro-${c}]`);
          const valor = previo.filtros?.[c] ?? '';
          if (sel && [...sel.options].some((o) => o.value === valor)) {
            sel.value = valor;
            filtros[c] = valor;
          }
        }
      }
    } catch {}
    aplicar();
  });
</script>

<style>
  .estanteria {
    --hueco-x: clamp(12px, 2.4vw, 26px);
  }
  .herramientas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    margin-bottom: 18px;
  }
  .grupo {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .punto {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--c);
  }
  select {
    font: 500 0.92rem var(--f-texto);
    color: var(--txt);
    background: var(--sup);
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 8px 12px;
  }
  .cuenta {
    margin: 0 0 0 auto;
    color: var(--txt-2);
    font-size: 0.9rem;
  }
  .estante {
    list-style: none;
    margin: 0;
    padding: 0 calc(var(--hueco-x) / 2);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(92px, 26vw, 160px), 1fr));
    column-gap: var(--hueco-x);
    row-gap: 18px;
  }
  .boton-filtros {
    display: none;
  }
  .activos {
    min-width: 1.4em;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--acento);
    color: #fff;
    font-size: 0.78rem;
    line-height: 1.4em;
    text-align: center;
  }
  @media (max-width: 760px) {
    .boton-filtros {
      display: inline-flex;
    }
    .estanteria:not([data-filtros-abiertos]) .selects {
      display: none;
    }
    .selects {
      width: 100%;
    }
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: -6px 0 16px;
    font-size: 0.85rem;
    color: var(--txt-2);
  }
  .marco {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
  }
  .muestra {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .estanteria[data-vista='lista'] .estante {
    grid-template-columns: 1fr;
    row-gap: 0;
    padding: 0;
  }
  .estanteria[data-vista='lista'] .cabecera {
    margin-top: 24px;
  }
  .estanteria[data-orden='historia'] :global(.celda) {
    --orden: var(--o-h);
  }
  .estanteria[data-orden='estreno'] :global(.celda) {
    --orden: var(--o-e);
  }
  .cabecera {
    grid-column: 1 / -1;
    order: var(--orden, 0);
    margin: 18px 0 -4px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }
  .cabecera h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
  }
  .cabecera .etapa {
    color: var(--acento-txt);
  }
  .cabecera p {
    margin: 0;
    color: var(--txt-2);
    font-size: 0.92rem;
  }
  .ver-orden {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .estanteria[data-orden='historia'] .cabecera {
    --orden: var(--o-h);
  }
  .estanteria[data-orden='estreno'] .cabecera {
    display: none;
  }
  .vacio {
    color: var(--txt-2);
    padding: 30px 0;
    text-align: center;
  }
</style>
