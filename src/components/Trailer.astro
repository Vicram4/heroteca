---
/**
 * Tráiler de YouTube con carga diferida: hasta que se pulsa solo se muestra una imagen
 * (de TMDB), sin contactar con YouTube. Al pulsar se carga desde youtube-nocookie.com.
 */
import { imagenTmdb } from '../lib/tmdb';

interface Props {
  id: string;
  titulo: string;
  fondo?: string;
}
const { id, titulo, fondo } = Astro.props;
---

<div class="trailer" data-trailer={id}>
  <button type="button" class="reproducir" aria-label={`Reproducir el tráiler de ${titulo} (se carga desde YouTube)`}>
    {fondo && <img src={imagenTmdb(fondo, 'w780')} alt="" loading="lazy" decoding="async" width="780" height="439" />}
    <span class="icono" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z"></path></svg>
    </span>
    <span class="texto">Ver tráiler</span>
  </button>
  <p class="aviso">Al reproducirlo se conecta con YouTube (modo de privacidad mejorada).</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-trailer]').forEach((caja) => {
    caja.querySelector('button')!.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${caja.dataset.trailer}?autoplay=1&rel=0`;
      iframe.title = caja.querySelector('button')!.getAttribute('aria-label')!.replace('Reproducir el', 'Tráiler:').replace(' (se carga desde YouTube)', '');
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      caja.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .trailer {
    position: relative;
  }
  .reproducir,
  .trailer :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radio);
    overflow: hidden;
  }
  .reproducir {
    position: relative;
    padding: 0;
    cursor: pointer;
    background: radial-gradient(circle at 50% 40%, var(--sup-2), #000);
    color: #fff;
  }
  .reproducir img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    transition: opacity var(--transicion), transform 0.5s ease;
  }
  .reproducir:hover img,
  .reproducir:focus-visible img {
    opacity: 0.9;
    transform: scale(1.02);
  }
  .icono {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 74px;
    height: 74px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--acento);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.5);
  }
  .texto {
    position: absolute;
    left: 16px;
    bottom: 12px;
    font: 700 1.1rem var(--f-titulo);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.8);
  }
  .aviso {
    font-size: 0.78rem;
    color: var(--txt-2);
    margin: 6px 0 0;
  }
</style>
