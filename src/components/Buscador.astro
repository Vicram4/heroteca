---
/**
 * Buscador instantáneo de títulos (y, más adelante, personajes).
 * Se abre con el botón, con "/" o con Ctrl+K. Navegable con teclado.
 */
import { textos, idiomaDe } from '../i18n';
const tx = textos(Astro.url);
const indice = idiomaDe(Astro.url) === 'en' ? '/en/buscar.json' : '/buscar.json';
---

<button type="button" class="abrir-buscar pastilla" data-abrir-buscar aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
    <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path>
  </svg>
  <span class="texto">{tx.buscador.boton}</span>
  <kbd>/</kbd>
</button>

<dialog
  class="buscador"
  data-buscador
  aria-label={tx.buscador.dialogo}
  data-indice={indice}
  data-escribe={tx.buscador.escribe}
  data-cargando={tx.buscador.cargando}
  data-sin={tx.buscador.sinResultados}
  data-resultados-txt={tx.buscador.resultados}
>
  <form method="dialog" class="caja-busqueda" role="search" onsubmit="return false">
    <label for="campo-buscar" class="solo-lectores">{tx.buscador.etiqueta}</label>
    <input id="campo-buscar" type="search" autocomplete="off" spellcheck="false"
      placeholder={tx.buscador.placeholder}
      role="combobox" aria-expanded="true" aria-controls="resultados-buscar" aria-autocomplete="list" />
    <button type="button" class="cerrar" data-cerrar-buscar aria-label={tx.buscador.cerrar}>Esc</button>
  </form>
  <p class="estado" aria-live="polite" data-estado>{tx.buscador.escribe}</p>
  <ul id="resultados-buscar" class="resultados" role="listbox" data-resultados></ul>
</dialog>

<script>
  interface Item {
    t: string; o: string; a: string[]; r: string; u: string; y: number; k: string; c: string; n: string; s: string; i?: string;
  }
  const dialogo = document.querySelector<HTMLDialogElement>('[data-buscador]')!;
  const campo = dialogo.querySelector<HTMLInputElement>('input')!;
  const lista = dialogo.querySelector<HTMLUListElement>('[data-resultados]')!;
  const estado = dialogo.querySelector<HTMLParagraphElement>('[data-estado]')!;
  let indice: (Item & { _t: string; _o: string; _r: string })[] | null = null;
  let activo = -1;

  const normal = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

  async function cargar() {
    if (indice) return;
    estado.textContent = dialogo.dataset.cargando!;
    const datos: Item[] = await (await fetch(dialogo.dataset.indice!)).json();
    indice = datos.map((d) => ({ ...d, _t: normal([d.t, ...d.a].join(' ')), _o: normal(d.o), _r: normal(d.r) }));
    estado.textContent = dialogo.dataset.escribe!;
  }

  function puntuar(d: NonNullable<typeof indice>[number], q: string, palabras: string[]) {
    const texto = `${d._t} ${d._o}`;
    if (!palabras.every((p) => texto.includes(p) || d._r.includes(p) || d.n === p)) return 0;
    let s = 1;
    if (d._t.startsWith(q) || d._o.startsWith(q)) s += 6;
    else if (texto.includes(q)) s += 3;
    if (d.n === q) s += 8;
    return s;
  }

  function buscar() {
    if (!indice) return;
    const q = normal(campo.value);
    lista.innerHTML = '';
    activo = -1;
    if (!q) {
      estado.textContent = dialogo.dataset.escribe!;
      return;
    }
    const palabras = q.split(' ');
    const resultados = indice
      .map((d) => ({ d, s: puntuar(d, q, palabras) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.d.y - b.d.y)
      .slice(0, 30);
    estado.textContent = resultados.length ? `${resultados.length}${resultados.length === 30 ? '+' : ''} ${dialogo.dataset.resultadosTxt}` : dialogo.dataset.sin!;
    for (const [i, { d }] of resultados.entries()) {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.id = `res-${i}`;
      li.innerHTML = `<a href="${d.u}" class="t-${d.c}" tabindex="-1">
        ${d.i ? `<img src="${d.i}" alt="" width="40" height="53" loading="lazy">` : '<span class="sin-img"></span>'}
        <span class="txt"><strong></strong><small></small></span>
        <span class="num"></span></a>`;
      li.querySelector('strong')!.textContent = d.t;
      li.querySelector('small')!.textContent = [d.o && d.o !== d.t ? d.o : '', [d.k, d.y || ""].filter(Boolean).join(" · "), d.s].filter(Boolean).join(' · ');
      li.querySelector('.num')!.textContent = d.n;
      lista.append(li);
    }
  }

  function marcar(i: number) {
    const items = [...lista.children] as HTMLElement[];
    if (!items.length) return;
    activo = (i + items.length) % items.length;
    items.forEach((el, j) => el.setAttribute('aria-selected', String(j === activo)));
    campo.setAttribute('aria-activedescendant', items[activo].id);
    items[activo].scrollIntoView({ block: 'nearest' });
  }

  async function abrir() {
    dialogo.showModal();
    campo.select();
    await cargar();
    buscar();
  }

  document.querySelectorAll('[data-abrir-buscar]').forEach((b) => b.addEventListener('click', abrir));
  dialogo.querySelector('[data-cerrar-buscar]')!.addEventListener('click', () => dialogo.close());
  dialogo.addEventListener('click', (e) => e.target === dialogo && dialogo.close());
  campo.addEventListener('input', buscar);
  campo.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); marcar(activo + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); marcar(activo - 1); }
    else if (e.key === 'Enter') {
      const a = lista.children[Math.max(activo, 0)]?.querySelector('a');
      if (a) location.href = a.href;
    }
  });
  addEventListener('keydown', (e) => {
    const escribiendo = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.key === '/' && !escribiendo) || (e.key.toLowerCase() === 'k' && (e.ctrlKey || e.metaKey))) {
      e.preventDefault();
      abrir();
    }
  });
</script>

<style>
  .abrir-buscar {
    min-width: 200px;
    justify-content: flex-start;
    color: var(--txt-2);
    font-weight: 500;
  }
  .abrir-buscar kbd {
    margin-left: auto;
    font: 600 0.75rem var(--f-texto);
    border: 1px solid var(--borde);
    border-radius: 5px;
    padding: 1px 6px;
  }
  @media (max-width: 760px) {
    .abrir-buscar {
      min-width: 0;
    }
    /* El texto se oculta a la vista pero los lectores de pantalla lo siguen leyendo */
    .abrir-buscar .texto {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .abrir-buscar kbd {
      display: none;
    }
  }
  .buscador {
    width: min(680px, calc(100vw - 24px));
    max-height: min(80vh, 720px);
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--sup);
    color: var(--txt);
    box-shadow: var(--sombra);
  }
  .buscador::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(3px);
  }
  .caja-busqueda {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-bottom: 1px solid var(--borde);
    position: sticky;
    top: 0;
    background: var(--sup);
  }
  .caja-busqueda input {
    flex: 1;
    font: 500 1.1rem var(--f-texto);
    color: var(--txt);
    background: var(--sup-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio-s);
    padding: 10px 12px;
  }
  .cerrar {
    background: none;
    border: 1px solid var(--borde);
    border-radius: var(--radio-s);
    padding: 0 10px;
    cursor: pointer;
    color: var(--txt-2);
  }
  .estado {
    margin: 0;
    padding: 10px 16px 4px;
    font-size: 0.85rem;
    color: var(--txt-2);
  }
  .resultados {
    list-style: none;
    margin: 0;
    padding: 4px 8px 10px;
  }
  .resultados :global(a) {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 8px;
    border-radius: var(--radio-s);
    text-decoration: none;
    border-left: 3px solid var(--c);
  }
  .resultados :global(li[aria-selected='true'] a),
  .resultados :global(a:hover) {
    background: var(--sup-2);
  }
  .resultados :global(img),
  .resultados :global(.sin-img) {
    width: 40px;
    height: 53px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--sup-2);
  }
  .resultados :global(.txt) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .resultados :global(strong) {
    font-weight: 600;
  }
  .resultados :global(small) {
    color: var(--txt-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .resultados :global(.num) {
    font: 700 1rem var(--f-titulo);
    color: var(--acento-txt);
  }
</style>
