---
/** Ficha de un título: tu «Ficha Técnica» modernizada. */
import Caratula from './Caratula.astro';
import Trailer from './Trailer.astro';
import { render } from 'astro:content';
import Spoiler from './Spoiler.astro';
import DondeVer from './DondeVer.astro';
import { numeroTexto, todosLosTitulos, urlCarpeta, localizar, type Titulo, type Universo, type Saga } from '../lib/datos';
import { apariciones, enlacesRepartoEn } from '../lib/personajes';
import { paginaDeActor, claveActor } from '../lib/actores';
import { universoLoc, sagaLoc } from '../i18n/datos';
import { textos, idiomaDe, nombreTipo, LOCALE } from '../i18n';

interface Props {
  t: Titulo;
  universo: Universo;
  sagas: Saga[];
  anterior?: Titulo;
  siguiente?: Titulo;
  /** Otras temporadas de la misma serie */
  temporadas: Titulo[];
}
const idioma = idiomaDe(Astro.url);
const t = localizar(Astro.props.t, idioma);
const universo = universoLoc(Astro.props.universo, idioma);
const sagas = Astro.props.sagas.map((s) => sagaLoc(s, idioma));
const anterior = localizar(Astro.props.anterior, idioma);
const siguiente = localizar(Astro.props.siguiente, idioma);
const temporadas = Astro.props.temporadas.map((o) => localizar(o, idioma));
const d = t.d;
const tx = textos(Astro.url);
const f = tx.ficha;
const tipoTexto = d.animada ? tx.general.animado(nombreTipo(d.tipo, idioma)) : nombreTipo(d.tipo, idioma);
const seccion = universo.data.secciones.find((s) => s.id === d.seccion);
const { Content } = await render(t.entrada);
const tieneCuerpo = Boolean(t.entrada.body?.trim());
const misSagas = d.sagas.map((r) => sagas.find((s) => s.id === r.id)).filter((s): s is Saga => Boolean(s));
const numeros = d.tramos.length > 1 ? d.tramos.map((tr) => numeroTexto(tr.numero)).join(' · ') : numeroTexto(d.numero);
const m = t.m;
const lista = (v: string[]) => v.join(', ');
const fechaLarga = (x?: Date) => x?.toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const marca = (campo: string) => (m.deTmdb.has(campo) ? ' ·ᵀ' : '');
const tecnica = [
  [f.anio, d.anioFin ? `${d.anio}–${d.anioFin}` : String(d.anio)],
  [f.estrenoCampo, fechaLarga(m.fecha)],
  [f.enEspana, m.fechaEspana && m.fechaEspana.getTime() !== m.fecha?.getTime() ? fechaLarga(m.fechaEspana) : undefined],
  [f.nacionalidad, d.nacionalidad],
  [f.duracion, m.duracion ? `${m.duracion} min${d.tipo === 'serie' ? f.porCapitulo : ''}${marca('duracion')}` : undefined],
  [f.creadaPor, d.tipo === 'serie' && m.creadores.length ? lista(m.creadores) : undefined],
  [f.direccion, m.direccion.length ? lista(m.direccion) + marca('direccion') : undefined],
  [f.guion, m.guion.length ? lista(m.guion) + marca('guion') : undefined],
  [f.productora, lista(d.productora)],
  [f.distribuidora, lista(d.distribuidora)],
  [f.temporadas, m.temporadas ? String(m.temporadas) : undefined],
  [f.genero, m.generos.length ? lista(m.generos) : undefined],
].filter((f): f is [string, string] => Boolean(f[1]));
// La leyenda solo hace falta si hay marcas visibles (el tráiler no lleva marca)
const hayTmdb =
  [...m.deTmdb].some((c) => c !== 'trailer') ||
  (!t.portada && Boolean(m.posterTmdb)) ||
  (d.conexiones.postCreditos.length === 0 && m.escenasCreditos.length > 0);
const enlaceReparto = idioma === 'en' ? await enlacesRepartoEn() : (await apariciones()).enlaceReparto;
// Actores con página propia (/actores/<id>/)
const actorConPagina = await paginaDeActor();
const todos = await todosLosTitulos(idioma);
const buscarTitulo = (id: string) => todos.find((x) => x.id === id);
// «Ver antes / después»: los tuyos; si no hay, los vecinos en tus trilogías y dulogías (por fecha)
const fechaDe = (x: Titulo) => (x.m.fecha ? x.m.fecha.getTime() : Date.UTC(x.d.anio, 0, 1));
const vecinos = { antes: [] as Titulo[], despues: [] as Titulo[] };
const sagasVecinas: string[] = [];
for (const s of misSagas.filter((s) => s.data.tipo === 'trilogia')) {
  const miembros = todos.filter((x) => x.d.sagas.some((r) => r.id === s.id)).sort((a, b) => fechaDe(a) - fechaDe(b));
  const i = miembros.findIndex((x) => x.id === t.id);
  const antes = miembros[i - 1];
  const despues = miembros[i + 1];
  if (antes && !vecinos.antes.includes(antes)) vecinos.antes.push(antes);
  if (despues && !vecinos.despues.includes(despues)) vecinos.despues.push(despues);
  if (antes || despues) sagasVecinas.push(s.data.nombre);
}
const refs = (lista: { id: string }[]) => lista.map((r) => buscarTitulo(r.id)).filter((x): x is Titulo => Boolean(x));
const verAntes = refs(d.conexiones.verAntes);
const verDespues = refs(d.conexiones.verDespues);
const automaticas = !verAntes.length && !verDespues.length && sagasVecinas.length > 0;
const conexiones = [
  [f.verAntes, automaticas ? vecinos.antes : verAntes],
  [f.verDespues, automaticas ? vecinos.despues : verDespues],
  [f.relacionados, refs(d.conexiones.relacionados)],
].filter(([, lista]) => (lista as Titulo[]).length > 0) as [string, Titulo[]][];
// Escenas de los créditos: si no has escrito la tuya, el aviso de TMDB (sin contar nada)
const avisoCreditos =
  d.conexiones.postCreditos.length === 0 && m.escenasCreditos.length > 0
    ? m.escenasCreditos.length === 2
      ? f.creditosAmbas
      : m.escenasCreditos[0] === 'durante'
        ? f.creditosDurante
        : f.creditosFinal
    : undefined;
const tienePostCreditos = d.conexiones.postCreditos.length > 0 || m.escenasCreditos.length > 0;
const acentoTipo = d.tipo === 'pelicula' ? 'oro' : d.tipo === 'serie' ? 'plata' : 'ninguno';
---

<article class:list={['ficha', `t-${t.tipo}`, `brillo-${acentoTipo}`]}>
  <div class="arriba">
    <a class="volver pastilla" href={seccion ? `/${universo.id}/${seccion.id}/` : `/${universo.id}/`} data-volver>
      <span aria-hidden="true">←</span> {f.volver}
    </a>
  <nav class="miga" aria-label={tx.general.estasEn}>
    <a href={`/${universo.id}/`}>{universo.data.nombre}</a>
    <span aria-hidden="true">›</span>
    {seccion && <a href={`/${universo.id}/${seccion.id}/`}>{seccion.nombre}</a>}
    {
      d.visionado && (
        <>
          <span aria-hidden="true">›</span>
          <a href={urlCarpeta(universo.id, d.visionado.carpeta)}>{tx.general.carpeta(d.visionado.carpeta)}</a>
          {d.visionado.codigo && <span class="numero">{d.visionado.codigo}</span>}
        </>
      )
    }
    {numeros && <><span aria-hidden="true">›</span><span class="numero">{d.visionado ? f.carpetaDisco(numeros) : numeros}</span></>}
    {d.enEspera && <span class="archivo">{tx.general.enEspera}</span>}
    {d.paginaArchivador && <span class="archivo">{f.paginaArchivo(d.paginaArchivador)}</span>}
  </nav>
  </div>

  <div class="rejilla">
    <div class="caratulas">
      {
        t.portada || m.posterTmdb ? (
          <Caratula t={t} ancho={320} cargaInmediata alt={t.portada ? f.portadaColeccion(d.titulo) : f.cartel(d.titulo)} />
        ) : (
          <div class="sin-portada" aria-hidden="true">
            <span>{tipoTexto}</span>
            <strong>{d.titulo}</strong>
          </div>
        )
      }
      {t.contraportada && <Caratula t={t} contra ancho={320} alt={f.contraColeccion(d.titulo)} />}
      {t.portada && <p class="nota-caratula">{t.contraportada ? f.notaPortadaYContra : f.notaPortada}</p>}
      {!t.portada && m.posterTmdb && <p class="nota-caratula">{f.cartelTmdb}</p>}
      {
        t.portadaColeccion && (
          <div class="coleccion">
            <Caratula t={{ ...t, portada: t.portadaColeccion }} ancho={150} alt={f.portadaColeccion(d.titulo)} />
            {t.contraportadaColeccion && <Caratula t={{ ...t, contraportada: t.contraportadaColeccion }} contra ancho={150} alt={f.contraColeccion(d.titulo)} />}
            <p class="nota-caratula">{f.edicionColeccion}</p>
          </div>
        )
      }
    </div>

    <div class="cuerpo">
      <header class="cab">
        <h1>{d.titulo}</h1>
        {(d.tituloOriginal || d.temporada) && (
          <p class="original">
            {[d.temporada && tx.general.temporada(d.temporada), d.tituloOriginal].filter(Boolean).join(' · ')}
          </p>
        )}
        <ul class="chips" aria-label={f.datosRapidos}>
          <li><span class="chip tipo">{tipoTexto}</span></li>
          <li><span class="chip">{d.anioFin ? `${d.anio}–${d.anioFin}` : d.anio}</span></li>
          {m.duracion && <li><span class="chip">{m.duracion} min</span></li>}
          {tienePostCreditos && <li><span class="chip postcreditos">{f.postCreditos}</span></li>}
          {d.calidad.map((c) => <li><span class="chip calidad">{c === '4k' ? '4K' : c.toUpperCase()}</span></li>)}
          {misSagas.map((s) => <li><a class="chip" href={`/${universo.id}/sagas/${s.id}/`}>{s.data.nombre}</a></li>)}
        </ul>
        <button type="button" class="pastilla boton-visto" data-alternar-visto={t.id} aria-pressed="false">
          <span class="si-visto" aria-hidden="true">✓</span>
          <span class="no-visto">{tx.progreso.marcar}</span>
          <span class="si-visto">{tx.progreso.visto}</span>
        </button>
        {!d.fichaPropia && <p class="aviso-ficha">{f.sinFicha}</p>}
        {
          temporadas.length > 1 && (
            <nav class="temporadas" aria-label={f.todasTemporadas}>
              <span class="etiqueta-temp">{f.temporadas}:</span>
              <ul>
                {temporadas.map((o) => (
                  <li>
                    <a class="chip" href={o.url} aria-current={o.id === t.id ? 'page' : undefined}>
                      {tx.carpetas.temporadaCorta(o.d.temporada ?? 0)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </header>

      {
        t.m.argumento && (
          <section class="panel">
            <h2 class="h-panel">{t.m.deTmdb.has('argumento') ? f.sinopsis : f.argumento}</h2>
            {t.m.argumento.split(/\n\n+/).map((p) => <p>{p}</p>)}
            {t.m.deTmdb.has('argumento') && <p class="fuente-tmdb">{f.sinopsisTmdb}</p>}
          </section>
        )
      }

      <DondeVer id={t.id} titulo={t.corto} busqueda={d.titulo} />

      {t.m.trailer && <Trailer id={t.m.trailer} titulo={d.titulo} fondo={t.m.fondoTmdb} />}

      {
        tieneCuerpo && (
          <section class="panel texto-libre">
            <Content />
          </section>
        )
      }

      <div class="dos">
        {
          tecnica.length > 0 && (
            <section class="panel">
              <h2 class="h-panel">{f.fichaTecnica}</h2>
              <dl class="datos">
                {tecnica.map(([k, v]) => (
                  <>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
            </section>
          )
        }
        {
          m.reparto.length > 0 && (
            <section class="panel">
              <h2 class="h-panel">{f.reparto}</h2>
              <ul class="reparto">
                {m.reparto.map((r, i) => {
                  const pid = enlaceReparto.get(`${t.id}|${i}`);
                  const aid = actorConPagina.get(claveActor(r.actor));
                  return (
                    <li>
                      <span>{aid ? <a href={`/actores/${aid}/`}>{r.actor}</a> : r.actor}</span>
                      {pid ? <a href={`/${universo.id}/personajes/${pid}/`}>{r.personaje}</a> : <span>{r.personaje}</span>}
                    </li>
                  );
                })}
              </ul>
              {m.deTmdb.has('reparto') && <p class="fuente-tmdb">{f.repartoTmdb}</p>}
            </section>
          )
        }
      </div>

      {
        d.tramos.length > 1 && (
          <section class="panel">
            <h2 class="h-panel">{f.cronologia}</h2>
            <p class="ayuda">{f.repartida}</p>
            <ul class="tramos">
              {d.tramos.map((tr) => (
                <li>
                  <span class="numero">{numeroTexto(tr.numero)}</span> {f.capitulosDe(tr.desde, tr.hasta)}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        m.capitulos.length > 0 && (
          <section class="panel">
            <h2 class="h-panel">{f.capitulos} <span class="cuantos">({m.capitulos.length})</span></h2>
            <ol class="capitulos">
              {m.capitulos.map((c) => (
                <li>
                  <details>
                    <summary>
                      <span class="cod">{c.codigo}</span>
                      <span class="tit">{c.titulo}</span>
                      {c.duracion && <span class="dur">{c.duracion} min</span>}
                    </summary>
                    <div class="det">
                      {c.argumento && <p>{c.argumento}</p>}
                      <p class="cred">
                        {c.fecha && <span>{f.emision}: {fechaLarga(new Date(`${c.fecha}T00:00:00Z`))}</span>}
                        {c.direccion.length > 0 && <span>{f.direccion}: {lista(c.direccion)}</span>}
                        {c.guion.length > 0 && <span>{f.guion}: {lista(c.guion)}</span>}
                      </p>
                    </div>
                  </details>
                </li>
              ))}
            </ol>
            {m.deTmdb.has('capitulos') && <p class="fuente-tmdb">{f.capitulosTmdb}</p>}
          </section>
        )
      }

      {
        conexiones.length > 0 && (
          <section class="panel">
            <h2 class="h-panel">{f.conexiones}</h2>
            {automaticas && <p class="fuente-tmdb">{f.segunOrden(sagasVecinas.join(f.y))}</p>}
            <dl class="datos">
              {conexiones.map(([k, lista]) => (
                <>
                  <dt>{k}</dt>
                  <dd class="enlaces">
                    {lista.map((o) => (
                      <a class="chip" href={o.url}>{o.corto}</a>
                    ))}
                  </dd>
                </>
              ))}
            </dl>
          </section>
        )
      }

      {
        (d.conexiones.postCreditos.length > 0 || d.conexiones.cameos.length > 0 || avisoCreditos) && (
          <section class="panel">
            <h2 class="h-panel">{f.escenas}</h2>
            {
              avisoCreditos && (
                <p>
                  {avisoCreditos} {f.quedate} ·ᵀ
                </p>
              )
            }
            {d.conexiones.postCreditos.map((p) =>
              p.spoiler ? <Spoiler que={f.spoilerEscena}><p>{p.texto}</p></Spoiler> : <p>{p.texto}</p>,
            )}
            {d.conexiones.cameos.map((c) => (c.spoiler ? <Spoiler que={f.spoilerCameo}><p>{c.descripcion}</p></Spoiler> : <p>{c.descripcion}</p>))}
          </section>
        )
      }


      {hayTmdb && <p class="leyenda-tmdb">{f.leyendaTmdb}</p>}

      {
        d.notas && (
          <details class="notas">
            <summary>{f.notas}</summary>
            <p>{d.notas}</p>
          </details>
        )
      }
    </div>
  </div>

  <nav class="pasar" aria-label={f.pasarAria}>
    {
      anterior ? (
        <a href={anterior.url} rel="prev" class="pasar-a">
          <span class="flecha" aria-hidden="true">←</span>
          <span><small>{f.anterior}{anterior.d.numero !== undefined && ` · ${numeroTexto(anterior.d.numero)}`}</small>{anterior.corto}</span>
        </a>
      ) : <span />
    }
    {
      siguiente && (
        <a href={siguiente.url} rel="next" class="pasar-a sig">
          <span><small>{f.siguiente}{siguiente.d.numero !== undefined && ` · ${numeroTexto(siguiente.d.numero)}`}</small>{siguiente.corto}</span>
          <span class="flecha" aria-hidden="true">→</span>
        </a>
      )
    }
  </nav>
</article>

<script>
  // «Volver»: si se llega desde otra página de Heroteca, regresa a ella; si no (Google, enlace directo,
  // cambio de idioma), el enlace lleva a la estantería de la sección.
  document.querySelectorAll<HTMLAnchorElement>('[data-volver]').forEach((a) => {
    // Solo se vuelve atrás si la página anterior es de Heroteca y está en el mismo idioma. Si se acaba de
    // cambiar de idioma, «atrás» sería la misma ficha en el otro idioma: entonces se va a la estantería.
    const enIngles = (ruta: string) => ruta === '/en' || ruta.startsWith('/en/');
    let mismaWebEIdioma = false;
    try {
      const anterior = document.referrer ? new URL(document.referrer) : undefined;
      mismaWebEIdioma = Boolean(anterior) && anterior!.origin === location.origin && enIngles(anterior!.pathname) === enIngles(location.pathname);
    } catch {}
    if (!mismaWebEIdioma || history.length < 2) return;
    a.addEventListener('click', (e) => {
      e.preventDefault();
      history.back();
    });
  });
</script>

<style>
  .ficha {
    position: relative;
    padding-top: clamp(18px, 3vw, 30px);
  }
  /* Guiño a tus fichas: brillo ámbar en películas, plateado en series */
  .ficha::before {
    content: '';
    position: absolute;
    inset: 0 -50vw auto;
    height: 260px;
    z-index: -1;
    pointer-events: none;
    opacity: 0.16;
  }
  .brillo-oro::before {
    background: radial-gradient(60% 100% at 30% 0%, var(--dorado-peli), transparent 70%);
  }
  .brillo-plata::before {
    background: radial-gradient(60% 100% at 30% 0%, var(--plata-serie), transparent 70%);
    opacity: 0.22;
  }
  .arriba {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 18px;
  }
  .arriba .miga {
    margin-bottom: 0;
  }
  .volver {
    padding: 6px 12px;
    font-size: 0.9rem;
  }
  .temporadas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 14px;
  }
  .temporadas ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .etiqueta-temp {
    font: 700 0.85rem var(--f-titulo);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--txt-2);
  }
  .temporadas a[aria-current='page'] {
    background: var(--txt);
    color: var(--fondo);
    border-color: var(--txt);
  }
  .miga {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    align-items: baseline;
    font-size: 0.92rem;
    color: var(--txt-2);
    margin-bottom: 18px;
  }
  .miga a {
    text-decoration: none;
  }
  .miga a:hover {
    color: var(--txt);
    text-decoration: underline;
  }
  .miga .numero {
    font-size: 1.05rem;
  }
  .archivo {
    margin-left: auto;
  }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: start;
  }
  .caratulas {
    display: grid;
    gap: 14px;
    position: sticky;
    top: 140px;
  }
  .coleccion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 6px;
    opacity: 0.92;
  }
  .coleccion .nota-caratula {
    grid-column: 1 / -1;
  }
  .caratulas :global(img) {
    width: 100%;
    border-radius: 12px;
    box-shadow:
      0 0 0 3px var(--c),
      var(--sombra);
    background: var(--sup);
  }
  .sin-portada {
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 0 0 3px var(--c);
    background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--c) 20%, var(--sup)), var(--sup-2));
  }
  .sin-portada span {
    font: 700 0.85rem var(--f-titulo);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
  }
  .sin-portada strong {
    font: 800 1.8rem/1.05 var(--f-titulo);
  }
  .nota-caratula {
    font-size: 0.82rem;
    color: var(--txt-2);
    text-align: center;
    margin: 0;
  }
  .cuerpo {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .original {
    color: var(--txt-2);
    font-size: 1.15rem;
    margin: 8px 0 0;
  }
  /* Botón «Marcar como visto» (Mi progreso): el texto cambia con aria-pressed */
  .boton-visto {
    margin-top: 14px;
  }
  .boton-visto[aria-pressed='true'] {
    background: #1a7f45;
    border-color: #1a7f45;
    color: #fff;
  }
  .boton-visto[aria-pressed='true'] .no-visto,
  .boton-visto:not([aria-pressed='true']) .si-visto {
    display: none;
  }
  .chips {
    list-style: none;
    padding: 0;
