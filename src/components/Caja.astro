---
/** Una caja (carátula) en la estantería. El marco lleva el color del tipo, como en tus estanterías. */
import Caratula from './Caratula.astro';
import { numeroTexto, textoTramo, localizar, type Hueco } from '../lib/datos';
import { textos, idiomaDe, nombreTipo } from '../i18n';
import { clavePlataforma, plataformasIncluidas, paisDe } from '../lib/dondever';
import { datosTmdb } from '../lib/tmdb';

interface Props {
  hueco: Hueco;
  /** Carga inmediata para las primeras filas visibles */
  prioridad?: boolean;
  /** Ids de los personajes que aparecen (para el filtro) */
  personajes?: string[];
}
const { hueco, prioridad = false, personajes = [] } = Astro.props;
const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);
const t = localizar(hueco.titulo, idioma);
const tramo = textoTramo(hueco);
const decada = Math.floor(t.d.anio / 10) * 10;
const porCarpetas = hueco.carpeta !== undefined;
const enEspera = t.d.enEspera;
const plataformas = plataformasIncluidas(t.id, paisDe(idioma));
// Nota media de TMDB (con al menos VOTOS_MIN votos) para el orden «Mejor valoradas»; sin nota fiable, al final
const VOTOS_MIN = 50;
const tmdb = datosTmdb(t.universo, t.id, 'es');
const nota = tmdb?.nota && (tmdb.votos ?? 0) >= VOTOS_MIN ? tmdb.nota : undefined;
const tipoTexto = t.d.animada ? tx.general.animado(nombreTipo(t.tipo, idioma)) : nombreTipo(t.tipo, idioma);
---

<li
  class:list={['celda', `t-${t.tipo}`]}
  style={`--o-h:${hueco.ordenHistoria};--o-e:${hueco.ordenEstreno};--nota:${nota ? Math.round(nota * 10) : 0}`}
  data-tipo={t.tipo}
  data-animada={String(t.d.animada)}
  data-decada={decada}
  data-sagas={t.d.sagas.map((s) => s.id).join(' ')}
  data-repetido={hueco.repetido ? 'true' : undefined}
  data-titulo={t.id}
  data-personajes={personajes.join(' ')}
  data-carpeta={hueco.carpeta}
  data-plataformas={plataformas.map(clavePlataforma).join(' ')}
>
  <a href={t.url} class="caja">
    {
      porCarpetas ? (
        <>
          {(hueco.codigo || enEspera) && <span class:list={['num', 'num-h', { espera: !hueco.codigo }]}>{hueco.codigo ?? tx.general.enEspera}</span>}
          {hueco.numero !== undefined && <span class="num num-e">{numeroTexto(hueco.numero)}</span>}
        </>
      ) : (
        hueco.numero !== undefined && <span class="num">{numeroTexto(hueco.numero)}</span>
      )
    }
    <span class="tapa">
      <span class="marca-visto"><span aria-hidden="true">✓</span><span class="solo-lectores">{tx.progreso.visto}</span></span>
      {
        t.portada || t.m.posterTmdb ? (
          <Caratula t={t} ancho={160} cargaInmediata={prioridad} />
        ) : (
          <span class="sin-tapa" aria-hidden="true">
            <span class="tipo">{nombreTipo(t.tipo, idioma)}</span>
            <span class="nombre">{t.d.titulo}</span>
            {t.d.temporada && <span class="temp">{tx.general.temporada(t.d.temporada)}</span>}
          </span>
        )
      }
    </span>
    <span class="pie">
      <span class="nombre-pie">{t.corto}</span>
      {nota && <span class="nota-caja" title={tx.recomendar.nota}>★ {nota.toLocaleString(idioma === 'en' ? 'en-US' : 'es-ES', { minimumFractionDigits: 1 })}<span class="solo-lectores"> ({tx.recomendar.nota})</span></span>}
      <span class="extra">
        {tramo ? <><span class="solo-lectores">{tx.general.capitulos} </span>{tramo}</> : t.d.anio}
      </span>
      {/* En la estantería solo lo leen los lectores de pantalla; en la vista de lista se ve */}
      <span class="info-lista">
        <span class="solo-lectores">, </span>
        {tipoTexto}
        {enEspera && ` · ${tx.general.enEspera}`}
        {plataformas.length > 0 && <span class="plataformas"> · {plataformas.join(', ')}</span>}
      </span>
    </span>
  </a>
</li>

<style>
  /* Información de la vista de lista: oculta a la vista en la estantería */
  .info-lista {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* ---------- Vista de lista (la estantería lleva data-vista="lista") ---------- */
  :global(.estanteria[data-vista='lista']) .celda {
    padding: 0;
  }
  :global(.estanteria[data-vista='lista']) .celda::after {
    display: none;
  }
  :global(.estanteria[data-vista='lista']) .caja {
    display: grid;
    grid-template-columns: 3.4em 46px 1fr;
    align-items: center;
    gap: 14px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--borde);
    border-radius: 8px;
  }
  :global(.estanteria[data-vista='lista']) .caja:hover,
  :global(.estanteria[data-vista='lista']) .caja:focus-visible {
    transform: none;
    background: var(--sup);
  }
  :global(.estanteria[data-vista='lista']) .num {
    position: static;
    grid-column: 1;
    justify-self: start;
    box-shadow: none;
  }
  :global(.estanteria[data-vista='lista']) .tapa {
    grid-column: 2;
    width: 46px;
    border-radius: 5px;
    box-shadow: 0 0 0 2px var(--c);
  }
  :global(.estanteria[data-vista='lista']) .sin-tapa {
    padding: 2px;
  }
  :global(.estanteria[data-vista='lista']) .sin-tapa > :not(.tipo) {
    display: none;
  }
  :global(.estanteria[data-vista='lista']) .sin-tapa .tipo {
    font-size: 0.55rem;
  }
  :global(.estanteria[data-vista='lista']) .pie {
    grid-column: 3;
    align-items: flex-start;
    text-align: left;
    min-height: 0;
    margin: 0;
    font-size: 0.95rem;
  }
  :global(.estanteria[data-vista='lista']) .nombre-pie {
    -webkit-line-clamp: 1;
  }
  :global(.estanteria[data-vista='lista']) .info-lista {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip: auto;
    white-space: normal;
    color: var(--txt-2);
    font-size: 0.82rem;
  }
  .celda {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 18px 0 22px;
    order: var(--orden, 0);
  }
  /* El tramo de balda bajo cada caja: juntos forman la balda completa */
  .celda::after {
    content: '';
    position: absolute;
    left: calc(var(--hueco-x) / -2);
    right: calc(var(--hueco-x) / -2);
    bottom: 0;
    height: 14px;
    background: var(--balda);
    box-shadow: var(--luz-balda);
    border-radius: 2px;
  }
  .caja {
    position: relative;
    display: block;
    text-decoration: none;
    transition: transform var(--transicion);
  }
  .caja:hover,
  .caja:focus-visible {
    transform: translateY(-8px);
  }
  .caja:focus-visible {
    outline-offset: 6px;
    border-radius: 10px;
  }
  .num {
    position: absolute;
    z-index: 1;
    top: -10px;
    left: -6px;
    background: var(--acento);
    color: #fff;
    font: 700 0.85rem/1 var(--f-titulo);
    letter-spacing: 0.03em;
    padding: 5px 7px;
    border-radius: 6px;
    box-shadow: 0 3px 8px rgb(0 0 0 / 0.35);
  }
  .num.espera {
    background: var(--sup-2);
    color: var(--txt);
    border: 1px solid var(--borde);
  }
  /* Nota: solo se ve en el orden «Mejor valoradas» */
  .nota-caja {
    display: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--txt-2);
  }
  :global(.estanteria[data-orden='nota']) .nota-caja {
    display: block;
  }
  /* Fuera del orden de la historia (estreno, más recientes, mejor valoradas) se ve el número de la colección */
  :global(.estanteria:not([data-orden='historia'])) .num-h,
  :global(.estanteria[data-orden='historia']) .num-e {
    display: none;
  }
  .tapa {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radio-s);
    overflow: hidden;
    background: var(--sup-2);
    box-shadow:
      0 0 0 3px var(--c),
      0 14px 22px -12px rgb(0 0 0 / 0.65);
  }
  /* Marca de «visto» (Mi progreso): oculta hasta que src/lib/vistos.ts pone data-visto en la celda */
  .marca-visto {
    display: none;
  }
  .celda[data-visto] .marca-visto {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #1f9d55;
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    box-shadow: 0 0 0 2px #fff, 0 2px 6px rgb(0 0 0 / 0.4);
  }
  :global(.estanteria[data-vista='lista']) .celda[data-visto] .marca-visto {
    top: 2px;
    right: 2px;
    width: 18px;
    height: 18px;
    font-size: 0.65rem;
  }
  .tapa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-tapa {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 12px;
    text-align: center;
    background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--c) 18%, var(--sup)), var(--sup-2));
  }
  .sin-tapa .tipo {
    font: 700 0.78rem var(--f-titulo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c);
  }
  .sin-tapa .nombre {
    font: 700 1.1rem/1.1 var(--f-titulo);
  }
  .sin-tapa .temp {
    font-size: 0.8rem;
    color: var(--txt-2);
  }
  .pie {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 3.6em; /* dos líneas de título + año: alinea las carátulas de la fila */
    margin-top: 10px;
    font-size: 0.82rem;
    line-height: 1.25;
    text-align: center;
  }
  .nombre-pie {
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .extra {
    color: var(--txt-2);
    font-size: 0.78rem;
  }
</style>
