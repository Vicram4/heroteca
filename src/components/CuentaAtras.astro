---
/**
 * Contador grande del próximo estreno de cine: cartel de fondo, título, fecha y cuenta atrás en directo
 * (días, horas, minutos y segundos) con una animación al cambiar cada cifra. Sin JavaScript se ven los días
 * calculados al publicar la web. Respeta «reducir movimiento».
 */
import { type Estreno, textosEstreno, fechaDe, enlaceTmdb } from '../lib/proximamente';
import type { Universo } from '../lib/datos';
import { estiloUniverso } from '../lib/datos';
import { paisDe } from '../lib/dondever';
import { imagenTmdb } from '../lib/tmdb';
import { textos, idiomaDe, LOCALE } from '../i18n';

interface Props {
  e: Estreno;
  u?: Universo;
}
const { e, u } = Astro.props;
const tx = textos(Astro.url);
const p = tx.proximos;
const idioma = idiomaDe(Astro.url);
const x = textosEstreno(e, idioma);
const dia = fechaDe(e, paisDe(idioma));
const fecha = new Date(`${dia}T00:00:00Z`).toLocaleDateString(LOCALE[idioma], { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const diasAlPublicar = Math.max(0, Math.ceil((Date.parse(`${dia}T00:00:00Z`) - Date.now()) / 86400000));
const href = e.ficha ? `/${e.ficha}/` : enlaceTmdb(e, idioma);
const unidades = [
  ['dias', p.unidades.dias, String(diasAlPublicar)],
  ['horas', p.unidades.horas, '00'],
  ['minutos', p.unidades.minutos, '00'],
  ['segundos', p.unidades.segundos, '00'],
] as const;
---

<section class="cuenta-atras" style={estiloUniverso(u)} data-cuenta-atras data-objetivo={dia} data-hoy={p.hoy} aria-labelledby="t-cuenta-atras">
  {x.poster && <img class="fondo" src={imagenTmdb(x.poster, 'w780')} alt="" width="780" height="1170" loading="eager" decoding="async" />}
  <div class="contenido">
    {x.poster && <img class="cartel" src={imagenTmdb(x.poster, 'w342')} alt="" width="342" height="513" loading="eager" decoding="async" />}
    <div class="texto">
      <p class="antetitulo">{p.proximoGran}</p>
      <h2 id="t-cuenta-atras">
        <a href={href} rel={e.ficha ? undefined : 'noopener'}>{x.titulo}</a>
      </h2>
      <p class="fecha">
        {p.enCines} <time datetime={dia}>{fecha}</time>
      </p>
      <div role="timer" aria-live="off" aria-label={p.faltan(diasAlPublicar)}>
      <ol class="cifras">
        {
          unidades.map(([clave, nombre, valor]) => (
            <li>
              <span class="valor" data-unidad={clave}>
                {valor}
              </span>
              <span class="nombre">{nombre}</span>
            </li>
          ))
        }
      </ol>
      </div>
      <p class="hoy" data-es-hoy hidden>{p.hoyEstreno}</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cuenta-atras]').forEach((caja) => {
    // La cuenta va hasta la medianoche (hora del navegador) del día del estreno
    const [a, m, d] = (caja.dataset.objetivo ?? '').split('-').map(Number);
    const objetivo = new Date(a, m - 1, d).getTime();
    const celdas = Object.fromEntries([...caja.querySelectorAll<HTMLElement>('[data-unidad]')].map((c) => [c.dataset.unidad!, c]));
    const poner = (clave: string, texto: string) => {
      const c = celdas[clave];
      if (!c || c.textContent === texto) return;
      c.textContent = texto;
      c.classList.remove('cambia');
      void c.offsetWidth; // reinicia la animación
      c.classList.add('cambia');
    };
    const dos = (n: number) => String(n).padStart(2, '0');
    const actualizar = () => {
      const resto = objetivo - Date.now();
      if (resto <= 0) {
        caja.classList.add('estrenada');
        caja.querySelector<HTMLElement>('[data-es-hoy]')!.hidden = false;
        caja.querySelector<HTMLElement>('.cifras')!.hidden = true;
        return false;
      }
      const s = Math.floor(resto / 1000);
      poner('dias', String(Math.floor(s / 86400)));
      poner('horas', dos(Math.floor((s % 86400) / 3600)));
      poner('minutos', dos(Math.floor((s % 3600) / 60)));
      poner('segundos', dos(s % 60));
      return true;
    };
    if (actualizar()) {
      const reloj = setInterval(() => actualizar() || clearInterval(reloj), 1000);
    }
  });
</script>

<style>
  .cuenta-atras {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: calc(var(--radio) + 6px);
    background: #0b0d12;
    color: #fff;
    box-shadow: var(--sombra);
  }
  .fondo {
    position: absolute;
    inset: -20%;
    z-index: -2;
    width: 140%;
    height: 140%;
    object-fit: cover;
    filter: blur(28px) saturate(1.3);
    opacity: 0.55;
  }
  .cuenta-atras::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(5 7 12 / 0.92) 30%, rgb(5 7 12 / 0.55));
  }
  .contenido {
    display: flex;
    align-items: center;
    gap: clamp(18px, 4vw, 40px);
    padding: clamp(18px, 4vw, 36px);
  }
  .cartel {
    flex: none;
    width: clamp(96px, 16vw, 170px);
    height: auto;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--acento), 0 18px 40px -12px rgb(0 0 0 / 0.8);
  }
  .texto {
    min-width: 0;
  }
  .antetitulo {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffd166;
  }
  h2 {
    margin: 4px 0 2px;
    font: 800 clamp(1.6rem, 4.4vw, 3rem) / 1.05 var(--f-titulo);
  }
  h2 a {
    color: #fff;
    text-decoration: none;
  }
  h2 a:hover,
  h2 a:focus-visible {
    text-decoration: underline;
  }
  .fecha {
    margin: 0 0 16px;
    color: #c9cfdb;
    text-transform: none;
  }
  .cifras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(8px, 1.6vw, 14px);
  }
  .cifras li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: clamp(58px, 9vw, 92px);
    padding: 10px 8px 8px;
    border-radius: 12px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.04));
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.35);
    perspective: 400px;
  }
  .valor {
    display: block;
    font: 800 clamp(1.8rem, 5vw, 3.2rem) / 1 var(--f-titulo);
    font-variant-numeric: tabular-nums;
    transform-origin: 50% 100%;
  }
  .nombre {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #aab2c2;
  }
  /* Animación al cambiar una cifra: cae desde arriba como una hoja de un marcador */
  .valor.cambia {
    animation: caer 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes caer {
    from {
      transform: rotateX(-90deg);
      opacity: 0.2;
    }
    to {
      transform: rotateX(0);
      opacity: 1;
    }
  }
  .hoy {
    margin: 0;
    font: 800 clamp(1.6rem, 4vw, 2.6rem) var(--f-titulo);
    color: #ffd166;
  }
  @media (prefers-reduced-motion: reduce) {
    .valor.cambia {
      animation: none;
    }
  }
  @media (max-width: 560px) {
    .contenido {
      flex-direction: column;
      align-items: flex-start;
    }
    .cifras li {
      min-width: 64px;
      flex: 1;
    }
  }
</style>
