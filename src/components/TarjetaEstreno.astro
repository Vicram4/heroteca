---
/**
 * Tarjeta de un próximo estreno (página «Próximamente» y portada). Enlaza con la ficha si ya está en la colección;
 * si no, con TMDB. La cuenta atrás (anillo con los días que faltan) la pone el script de ListaEstrenos en el navegador.
 */
import type { Universo } from '../lib/datos';
import { estiloUniverso } from '../lib/datos';
import { type Estreno, enEmision, textosEstreno, enlaceTmdb, fechaDe } from '../lib/proximamente';
import { paisDe } from '../lib/dondever';
import { imagenTmdb } from '../lib/tmdb';
import { textos, idiomaDe, LOCALE } from '../i18n';

interface Props {
  e: Estreno;
  u?: Universo;
  conSinopsis?: boolean;
}
const { e, u, conSinopsis = false } = Astro.props;
const tx = textos(Astro.url);
const idioma = idiomaDe(Astro.url);
const x = textosEstreno(e, idioma);
const dia = fechaDe(e, paisDe(idioma));
const fecha = new Date(`${dia}T00:00:00Z`).toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const que = enEmision(e)
  ? tx.proximos.episodio(e.temporada ?? 1, e.episodio ?? 1, fecha)
  : e.tipo === 'pelicula'
    ? tx.proximos.pelicula
    : (e.temporada ?? 1) > 1
      ? tx.proximos.temporadaNueva(e.temporada ?? 1)
      : tx.proximos.serieNueva;
const href = e.ficha ? `/${e.ficha}/` : enlaceTmdb(e, idioma);
---

<li class="estreno" data-fecha={dia} data-universo={e.universo} style={estiloUniverso(u)}>
  <a href={href} rel={e.ficha ? undefined : 'noopener'}>
    <span class="cartel">
      {
        x.poster ? (
          <img
            src={imagenTmdb(x.poster, 'w342')}
            srcset={`${imagenTmdb(x.poster, 'w185')} 185w, ${imagenTmdb(x.poster, 'w342')} 342w`}
            sizes="(max-width: 600px) 45vw, 200px"
            alt=""
            width="342"
            height="513"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="sin-cartel" aria-hidden="true">{x.titulo}</span>
        )
      }
      {/* Anillo de cuenta atrás: se cierra a medida que se acerca el estreno (último año) */}
      <span class="cuenta" data-cuenta role="img" hidden>
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle class="pista" cx="20" cy="20" r="17" pathLength="100" />
          <circle class="arco" cx="20" cy="20" r="17" pathLength="100" />
        </svg>
        <span class="num" data-cuenta-num aria-hidden="true"></span>
        <span class="ud" data-cuenta-ud aria-hidden="true"></span>
      </span>
    </span>
    <span class="nombre">{x.titulo}</span>
    <span class="meta">
      {u?.data.nombre && <span class="marca-u">{u.data.nombre}</span>}
      {enEmision(e) ? que : <>{que} · <time datetime={dia}>{fecha}</time></>}
    </span>
    {conSinopsis && x.sinopsis && <span class="sinopsis">{x.sinopsis}</span>}
    <span class="destino">{e.ficha ? tx.proximos.enColeccion : `${tx.proximos.enTmdb} ↗`}</span>
  </a>
</li>

<style>
  .estreno a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .cartel {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--sup);
    box-shadow: 0 0 0 1px var(--borde), var(--sombra);
    transition: transform var(--transicion), box-shadow var(--transicion);
  }
  .estreno a:hover .cartel,
  .estreno a:focus-visible .cartel {
    transform: translateY(-3px);
    box-shadow: 0 0 0 2px var(--acento), var(--sombra);
  }
  .cartel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-cartel {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 12px;
    text-align: center;
    font: 700 1.1rem var(--f-titulo);
    text-transform: uppercase;
    background: radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--acento) 45%, #000), #05070c 80%);
    color: #fff;
  }
  .cuenta {
    --p: 0;
    position: absolute;
    left: 8px;
    bottom: 8px;
    display: grid;
    place-items: center;
    align-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgb(5 7 12 / 0.82);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.5);
    color: #fff;
    line-height: 1;
  }
  .cuenta svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .cuenta circle {
    fill: none;
    stroke-width: 3.5;
  }
  .pista {
    stroke: rgb(255 255 255 / 0.18);
  }
  .arco {
    stroke: var(--acento);
    stroke-linecap: round;
    stroke-dasharray: calc(var(--p) * 100) 100;
    transition: stroke-dasharray 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .num {
    font: 800 1.15rem var(--f-titulo);
  }
  .ud {
    margin-top: 1px;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c9cfdb;
  }
  /* El día del estreno: anillo completo y brillo */
  .cuenta.es-hoy {
    width: auto;
    min-width: 58px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--acento);
    animation: latido 1.6s ease-in-out infinite;
  }
  .cuenta.es-hoy svg,
  .cuenta.es-hoy .ud {
    display: none;
  }
  .cuenta.es-hoy .num {
    font-size: 0.95rem;
  }
  @keyframes latido {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--acento) 35%, transparent), 0 4px 14px rgb(0 0 0 / 0.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arco {
      transition: none;
    }
    .cuenta.es-hoy {
      animation: none;
    }
  }
  .nombre {
    margin-top: 4px;
    font: 700 1.05rem / 1.2 var(--f-titulo);
  }
  .meta {
    font-size: 0.85rem;
    color: var(--txt-2);
  }
  .marca-u {
    display: inline-block;
    margin-right: 6px;
    padding: 0 7px;
    border-radius: 4px;
    /* algo más oscuro que el acento para que el texto blanco tenga contraste AA */
    background: color-mix(in srgb, var(--acento) 82%, #000);
    color: #fff;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sinopsis {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.88rem;
    color: var(--txt-2);
  }
  .destino {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--acento-txt);
  }
</style>
