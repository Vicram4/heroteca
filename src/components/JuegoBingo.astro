---
/**
 * «Bingo de maratón»: cartón de 5×5 con momentos típicos (src/config/bingo.ts) y el centro libre. Cada navegador
 * tiene su cartón al azar, así cada amigo juega con el suyo; el cartón y lo marcado se guardan hasta pedir otro.
 */
import { MOMENTOS_BINGO } from '../config/bingo';
import { textos, idiomaDe } from '../i18n';

const tx = textos(Astro.url);
const j = tx.juegos;
const idioma = idiomaDe(Astro.url);
const momentos = MOMENTOS_BINGO.map((m) => m[idioma]);
const textosCliente = { libre: j.bingoLibre, linea: j.bingoLinea, lineas: j.bingoLineas('{n}'), completo: j.bingoCompleto, seguro: j.bingoSeguro, marcadas: j.bingoMarcadas('{n}') };
---

<div class="juego panel" data-bingo>
  <p class="marcador" data-marcador role="status"></p>
  <div class="carton" data-carton></div>
  <button type="button" class="pastilla" data-nuevo>{j.bingoNuevo}</button>
  <script type="application/json" data-momentos set:html={JSON.stringify(momentos)} />
  <script type="application/json" data-textos set:html={JSON.stringify(textosCliente)} />
</div>

<script>
  const CLAVE = 'heroteca:bingo';
  const CENTRO = 12;
  const LADO = [0, 1, 2, 3, 4];
  const LINEAS = [...LADO.map((f) => LADO.map((c) => f * 5 + c)), ...LADO.map((c) => LADO.map((f) => f * 5 + c)), [0, 6, 12, 18, 24], [4, 8, 12, 16, 20]];
  document.querySelectorAll<HTMLElement>('[data-bingo]').forEach((caja) => {
    const momentos: string[] = JSON.parse(caja.querySelector('[data-momentos]')!.textContent ?? '[]');
    const t = JSON.parse(caja.querySelector('[data-textos]')!.textContent ?? '{}');
    const carton = caja.querySelector<HTMLElement>('[data-carton]')!;
    const marcador = caja.querySelector<HTMLElement>('[data-marcador]')!;

    /** Veinticuatro momentos al azar, con un hueco (-1) en el centro. */
    function repartir() {
      const baraja = momentos.map((_, i) => i);
      for (let i = baraja.length - 1; i > 0; i--) {
        const k = Math.floor(Math.random() * (i + 1));
        [baraja[i], baraja[k]] = [baraja[k], baraja[i]];
      }
      const casillas = baraja.slice(0, 24);
      casillas.splice(CENTRO, 0, -1);
      return { casillas, marcadas: [] as number[] };
    }
    let estado = repartir();
    try {
      const guardado = JSON.parse(localStorage.getItem(CLAVE) ?? 'null');
      // Solo si encaja con la lista actual de momentos
      if (guardado?.casillas?.length === 25 && guardado.casillas.every((m: number) => m < momentos.length)) estado = guardado;
    } catch {}
    function guardar() {
      try {
        localStorage.setItem(CLAVE, JSON.stringify(estado));
      } catch {}
    }
    function pintar() {
      const marcadas = new Set([...estado.marcadas, CENTRO]);
      const hechas = LINEAS.filter((l) => l.every((i) => marcadas.has(i)));
      const enLinea = new Set(hechas.flat());
      carton.replaceChildren(
        ...estado.casillas.map((m, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = `casilla${marcadas.has(i) ? ' marcada' : ''}${enLinea.has(i) ? ' en-linea' : ''}`;
          b.textContent = m === -1 ? t.libre : momentos[m];
          b.setAttribute('aria-pressed', String(marcadas.has(i)));
          if (i === CENTRO) b.disabled = true;
          else
            b.addEventListener('click', () => {
              estado.marcadas = estado.marcadas.includes(i) ? estado.marcadas.filter((x) => x !== i) : [...estado.marcadas, i];
              guardar();
              pintar();
              carton.querySelectorAll('button')[i].focus();
            });
          return b;
        }),
      );
      marcador.textContent =
        marcadas.size === 25 ? t.completo : hechas.length === 1 ? t.linea : hechas.length > 1 ? t.lineas.replace('{n}', hechas.length) : t.marcadas.replace('{n}', estado.marcadas.length);
      marcador.classList.toggle('premio', hechas.length > 0);
    }
    guardar();
    pintar();
    caja.querySelector('[data-nuevo]')!.addEventListener('click', () => {
      if (estado.marcadas.length && !confirm(t.seguro)) return;
      estado = repartir();
      guardar();
      pintar();
    });
  });
</script>

<style>
  .juego {
    max-width: 760px;
  }
  .marcador {
    min-height: 1.5em;
    margin: 0 0 12px;
    font-weight: 700;
    color: var(--txt-2);
  }
  .marcador.premio {
    color: var(--visto-txt);
    font: 800 1.4rem var(--f-titulo);
  }
  .carton {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(3px, 1vw, 8px);
    margin-bottom: 16px;
  }
  .carton :global(.casilla) {
    min-height: clamp(76px, 15vw, 112px);
    padding: clamp(2px, 1vw, 8px);
    border-radius: 8px;
    border: 2px solid var(--borde);
    background: var(--sup-2, var(--sup));
    color: inherit;
    font-size: clamp(0.66rem, 1.9vw, 0.88rem);
    line-height: 1.2;
    overflow-wrap: break-word;
    hyphens: auto;
    cursor: pointer;
  }
  /* En el móvil, el panel cede su margen para que las palabras largas quepan enteras */
  @media (max-width: 480px) {
    .juego {
      padding-inline: 6px;
    }
    .carton :global(.casilla) {
      padding-inline: 1px;
      font-size: 0.64rem;
    }
  }
  .carton :global(.casilla:hover:not(:disabled)) {
    border-color: var(--acento);
  }
  .carton :global(.casilla.marcada) {
    background: color-mix(in srgb, var(--acento) 26%, var(--sup));
    border-color: var(--acento);
    font-weight: 700;
  }
  .carton :global(.casilla.en-linea) {
    border-color: var(--visto-txt);
    box-shadow: inset 0 0 0 2px var(--visto-txt);
  }
  .carton :global(.casilla:disabled) {
    cursor: default;
    color: inherit;
    opacity: 1;
  }
</style>
