---
/**
 * Columnas agrupadas (una por serie dentro de cada grupo), para «Estrenos por década». Una sola escala, eje con
 * marcas redondas, leyenda, el valor sobre la columna más alta de cada grupo, aviso al pasar el ratón (data-tip)
 * y la tabla con todos los datos.
 */
import { textos } from '../i18n';
import type { Serie } from './GraficoBarras.astro';

interface Props {
  /** `corta`: etiqueta para pantallas estrechas («’90») */
  grupos: { etiqueta: string; corta?: string; valores: Record<string, number> }[];
  series: Serie[];
  cabecera: string;
  etiqueta: string;
  formato: (n: number) => string;
}
const { grupos, series, cabecera, etiqueta, formato } = Astro.props;
const tx = textos(Astro.url);
const maxDato = Math.max(1, ...grupos.flatMap((g) => Object.values(g.valores)));
// Marcas del eje: paso redondo (1, 2, 5, 10, 20, 50…) con unas 4 divisiones
const paso = [1, 2, 5, 10, 20, 25, 50, 100, 200, 500].find((p) => maxDato / p <= 5) ?? 1000;
const tope = Math.ceil(maxDato / paso) * paso;
const marcas = Array.from({ length: tope / paso + 1 }, (_, i) => i * paso);
const colores = series.map((s) => `--c-${s.id}:${s.color}`).join(';');
---

<figure class="grafico" style={colores}>
  {
    series.length > 1 && (
      <ul class="leyenda" aria-hidden="true">
        {series.map((s) => (
          <li>
            <i style={`background:var(--c-${s.id})`} />
            {s.nombre}
          </li>
        ))}
      </ul>
    )
  }
  <div class="lienzo" role="img" aria-label={etiqueta}>
    <div class="eje" aria-hidden="true">
      {
        marcas.map((m) => (
          <span class="marca" style={`bottom:${(m / tope) * 100}%`}>
            <span>{m}</span>
          </span>
        ))
      }
    </div>
    <div class="grupos">
      {
        grupos.map((g) => {
          const mayor = Math.max(...series.map((s) => g.valores[s.id] ?? 0));
          return (
            <div class="grupo" data-tip={[g.etiqueta, ...series.map((s) => `${s.nombre}: ${formato(g.valores[s.id] ?? 0)}`)].join(' · ')}>
              <div class="columnas">
                {series.map((s) => {
                  const v = g.valores[s.id] ?? 0;
                  return (
                    <span class="col" style={`height:${(v / tope) * 100}%;background:var(--c-${s.id})`}>
                      {v === mayor && v > 0 && <span class="valor">{v}</span>}
                    </span>
                  );
                })}
              </div>
              <span class="etiqueta">
                <span class:list={{ larga: Boolean(g.corta) }}>{g.etiqueta}</span>
                {g.corta && <span class="corta" aria-hidden="true">{g.corta}</span>}
              </span>
            </div>
          );
        })
      }
    </div>
  </div>
  <details class="tabla">
    <summary>{tx.estadisticas.verTabla}</summary>
    <div class="tabla-desliza">
      <table>
        <thead>
          <tr>
            <th scope="col">{cabecera}</th>
            {series.map((s) => <th scope="col">{s.nombre}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            grupos.map((g) => (
              <tr>
                <th scope="row">{g.etiqueta}</th>
                {series.map((s) => <td>{formato(g.valores[s.id] ?? 0)}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .grafico {
    margin: 0;
  }
  .leyenda {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0 0 12px;
    padding: 0;
    font-size: 0.85rem;
    color: var(--txt-2);
  }
  .leyenda li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .leyenda i {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .lienzo {
    position: relative;
    height: 240px;
    margin: 18px 0 0 2.4em;
    padding-bottom: 1.8em;
  }
  .eje {
    position: absolute;
    inset: 0 0 1.8em 0;
  }
  /* Líneas de guía: finas, continuas y discretas */
  .marca {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px solid var(--borde);
  }
  .marca span {
    position: absolute;
    right: calc(100% + 6px);
    transform: translateY(-50%);
    font-size: 0.75rem;
    color: var(--txt-2);
    font-variant-numeric: tabular-nums;
  }
  .grupos {
    position: absolute;
    inset: 0;
    display: flex;
  }
  .grupo {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .columnas {
    flex: 1;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 2px;
  }
  .col {
    position: relative;
    width: min(40%, 20px);
    /* extremo redondeado arriba, cuadrado en la línea base */
    border-radius: 4px 4px 0 0;
  }
  .valor {
    position: absolute;
    bottom: calc(100% + 3px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--txt-2);
  }
  .etiqueta {
    height: 1.8em;
    padding-top: 6px;
    font-size: 0.75rem;
    color: var(--txt-2);
    white-space: nowrap;
  }
  .corta {
    display: none;
  }
  @media (max-width: 560px) {
    .larga {
      display: none;
    }
    .corta {
      display: inline;
    }
  }
  .tabla {
    margin-top: 14px;
    font-size: 0.88rem;
  }
  .tabla summary {
    cursor: pointer;
    color: var(--txt-2);
    font-weight: 600;
  }
  .tabla-desliza {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    margin-top: 10px;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 6px 12px;
    border-bottom: 1px solid var(--borde);
    text-align: right;
  }
  th:first-child {
    text-align: left;
  }
</style>
