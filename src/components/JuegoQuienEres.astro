---
/**
 * «¿Qué héroe eres?»: preguntas de una en una (src/config/quien-eres.ts); cada respuesta suma puntos a varios
 * héroes y al final se muestra el que más tiene, con su descripción y un enlace a su página.
 */
import { PREGUNTAS, RESULTADOS } from '../config/quien-eres';
import { textos, idiomaDe } from '../i18n';
import { rutaEnIdioma } from '../i18n/rutas';

const tx = textos(Astro.url);
const j = tx.juegos;
const idioma = idiomaDe(Astro.url);
const preguntas = PREGUNTAS.map((p) => ({ texto: p[idioma], respuestas: p.respuestas.map((r) => ({ texto: r[idioma], puntos: r.puntos })) }));
const resultados = await Promise.all(
  RESULTADOS.map(async (r) => ({ id: r.id, ...r[idioma], url: await rutaEnIdioma(`/${r.universo}/personajes/${r.id}/`, idioma) })),
);
---

<div class="juego panel" data-quien data-plantilla={j.pregunta(91, 92)}>
  <div data-preguntas>
    <p class="numero" data-numero></p>
    <h2 tabindex="-1" data-texto-pregunta></h2>
    <div class="respuestas" data-respuestas></div>
  </div>
  <div class="resultado" data-resultado hidden>
    <p class="eres">{j.eres}</p>
    <h2 tabindex="-1" data-nombre></h2>
    <p data-descripcion></p>
    <div class="acciones">
      <a data-enlace>{j.verFicha} →</a>
      <button type="button" class="pastilla principal" data-otra-vez>{j.otraVez}</button>
    </div>
  </div>
  <script type="application/json" data-datos set:html={JSON.stringify({ preguntas, resultados })} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-quien]').forEach((caja) => {
    const { preguntas, resultados } = JSON.parse(caja.querySelector('[data-datos]')!.textContent ?? '{}') as {
      preguntas: { texto: string; respuestas: { texto: string; puntos: Record<string, number> }[] }[];
      resultados: { id: string; nombre: string; texto: string; url: string }[];
    };
    const $ = <T extends HTMLElement>(s: string) => caja.querySelector<T>(s)!;
    let paso = 0;
    let puntos: Record<string, number> = {};
    function pintar(enfocar: boolean) {
      const p = preguntas[paso];
      $('[data-numero]').textContent = (caja.dataset.plantilla ?? '').replace('91', String(paso + 1)).replace('92', String(preguntas.length));
      $('[data-texto-pregunta]').textContent = p.texto;
      $('[data-respuestas]').replaceChildren(
        ...p.respuestas.map((r) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'respuesta';
          b.textContent = r.texto;
          b.addEventListener('click', () => {
            for (const [id, n] of Object.entries(r.puntos)) puntos[id] = (puntos[id] ?? 0) + n;
            paso++;
            if (paso < preguntas.length) pintar(true);
            else terminar();
          });
          return b;
        }),
      );
      if (enfocar) $('[data-texto-pregunta]').focus();
    }
    function terminar() {
      // El de más puntos; a igualdad, el primero de la lista
      const ganador = resultados.reduce((mejor, r) => ((puntos[r.id] ?? 0) > (puntos[mejor.id] ?? 0) ? r : mejor), resultados[0]);
      $('[data-preguntas]').hidden = true;
      $('[data-resultado]').hidden = false;
      $('[data-nombre]').textContent = ganador.nombre;
      $('[data-descripcion]').textContent = ganador.texto;
      $<HTMLAnchorElement>('[data-enlace]').href = ganador.url;
      $('[data-nombre]').focus();
    }
    $('[data-otra-vez]').addEventListener('click', () => {
      paso = 0;
      puntos = {};
      $('[data-preguntas]').hidden = false;
      $('[data-resultado]').hidden = true;
      pintar(true);
    });
    pintar(false);
  });
</script>

<style>
  .juego {
    max-width: 760px;
  }
  .numero,
  .eres {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--txt-2);
  }
  h2 {
    margin: 6px 0 18px;
    font-size: clamp(1.4rem, 3.4vw, 1.9rem);
    outline: none;
  }
  .respuestas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 10px;
  }
  .respuestas :global(.respuesta) {
    padding: 16px;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
    background: var(--sup-2, var(--sup));
    color: inherit;
    font: 600 1rem var(--f-texto, inherit);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--transicion), transform var(--transicion);
  }
  .respuestas :global(.respuesta:hover) {
    border-color: var(--acento);
    transform: translateY(-2px);
  }
  .resultado h2 {
    font-size: clamp(2rem, 6vw, 3.2rem);
    box-shadow: inset 0 -0.13em 0 var(--acento);
    display: inline-block;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 14px;
  }
  .principal {
    background: var(--txt);
    color: var(--fondo);
    border-color: var(--txt);
  }
</style>
