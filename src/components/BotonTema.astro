---
/** Cambia entre modo claro y oscuro. Empieza siguiendo al sistema y recuerda la elección. */
import { textos } from '../i18n';
const tx = textos(Astro.url);
---

<button type="button" class="boton-tema pastilla" data-boton-tema aria-label={tx.tema.aOscuro} data-a-oscuro={tx.tema.aOscuro} data-a-claro={tx.tema.aClaro}>
  <svg class="sol" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="luna" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
    <path d="M20.5 14.4A8.5 8.5 0 0 1 9.6 3.5a8.5 8.5 0 1 0 10.9 10.9Z"></path>
  </svg>
</button>

<script>
  const raiz = document.documentElement;
  const oscuroSistema = matchMedia('(prefers-color-scheme: dark)');
  const esOscuro = () => (raiz.dataset.tema ? raiz.dataset.tema === 'oscuro' : oscuroSistema.matches);

  function actualizar() {
    document.querySelectorAll<HTMLButtonElement>('[data-boton-tema]').forEach((b) => {
      b.setAttribute('aria-label', (esOscuro() ? b.dataset.aClaro : b.dataset.aOscuro) ?? '');
      b.dataset.oscuro = String(esOscuro());
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-boton-tema]').forEach((b) =>
    b.addEventListener('click', () => {
      const nuevo = esOscuro() ? 'claro' : 'oscuro';
      raiz.dataset.tema = nuevo;
      try {
        localStorage.setItem('tema', nuevo);
      } catch {}
      actualizar();
    }),
  );
  oscuroSistema.addEventListener('change', actualizar);
  actualizar();
</script>

<style>
  .boton-tema {
    padding: 8px 10px;
  }
  .boton-tema .luna,
  .boton-tema[data-oscuro='true'] .sol {
    display: none;
  }
  .boton-tema[data-oscuro='true'] .luna {
    display: block;
  }
</style>
